sequenceDiagram
    participant App as TelegramChatbotSchedulingService
    participant Appointment as IServiceAppointmentService
    participant Repo as IServiceAppointmentCalendarSyncRepository
    participant GCal as IGoogleCalendarService
    participant Db as ServiceAppointmentCalendarSyncs

    App->>Appointment: CreateAsync(...)
    alt agendamento criado com sucesso
        Appointment-->>App: Success + AppointmentId
        App->>Repo: GetByAppointmentIdAsync(appointmentId)
        Repo->>Db: Select por AppointmentId
        Db-->>Repo: registro ou null
        Repo-->>App: resultado

        alt nao existe sync
            App->>Repo: AddAsync(sync: Pending)
            Repo->>Db: Insert
            Db-->>Repo: ok
            Repo-->>App: ok
        else sync ja existe
            App->>Repo: UpdateAsync(sync: Pending, Error=null)
            Repo->>Db: Update
            Db-->>Repo: ok
            Repo-->>App: ok
        end

        App->>GCal: CreateEventAsync(Title,Window,Metadata,IdempotencyKey=appointmentId)
        alt create ok
            GCal-->>App: Success + GoogleEventId
            App->>Repo: UpdateAsync(sync: Synced, GoogleEventId, LastSyncAtUtc)
            Repo->>Db: Update
            Db-->>Repo: ok
            Repo-->>App: ok
        else create falha
            GCal-->>App: ErrorCode/ErrorMessage
            App->>Repo: UpdateAsync(sync: Failed, Error, LastSyncAtUtc)
            Repo->>Db: Update
            Db-->>Repo: ok
            Repo-->>App: ok
        end
    else agendamento falha
        Appointment-->>App: ErrorCode/ErrorMessage
        App-->>App: Nao cria/atualiza sync
    end
