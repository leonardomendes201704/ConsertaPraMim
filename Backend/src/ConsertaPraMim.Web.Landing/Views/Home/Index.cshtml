@using ConsertaPraMim.Web.Landing.Models
@model LandingPageViewModel
@{
    Layout = "_Layout";
}

<main id="top" class="landing-main">
    <section class="hero-section">
        <div class="container hero-shell">
            <div class="hero-copy" data-reveal>
                <span class="hero-kicker">Plataforma de reparos e atendimento qualificado</span>
                <h1>Bem-vindo ao ConsertaPraMim</h1>
                <p class="hero-lead">
                    A solução inteligente para reparos domésticos e profissionais qualificados.
                    Como você deseja utilizar nossa plataforma hoje?
                </p>
            </div>

            <div class="portal-grid" id="acessos">
                <article class="portal-card" data-reveal>
                    <div class="portal-media portal-media-client">
                        <span class="portal-media-badge portal-media-badge-left" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                <path d="M8 7V6a4 4 0 0 1 8 0v1h2.5A1.5 1.5 0 0 1 20 8.5v8A1.5 1.5 0 0 1 18.5 18h-13A1.5 1.5 0 0 1 4 16.5v-8A1.5 1.5 0 0 1 5.5 7H8Zm2 0h4V6a2 2 0 1 0-4 0v1Zm-4 4h12v5H6v-5Z" />
                            </svg>
                        </span>
                        <img src="~/images/landing-client-card.svg" alt="Ilustração de um profissional pronto para atender um cliente." />
                    </div>
                    <div class="portal-body">
                        <h2>Para Clientes</h2>
                        <p>
                            Precisa de um conserto rápido ou uma reforma planejada? Encontre profissionais verificados
                            da sua região com mais clareza, agilidade e garantia de qualidade.
                        </p>
                        <a class="btn btn-primary btn-block" href="@Model.ClientPortalUrl">
                            Encontrar Profissional
                            <span class="button-icon" aria-hidden="true">→</span>
                        </a>
                        <div class="portal-proof">
                            <div class="avatar-stack" aria-hidden="true">
                                <span class="avatar-chip">L</span>
                                <span class="avatar-chip">M</span>
                                <span class="avatar-chip">A</span>
                            </div>
                            <span>+500 pessoas contrataram hoje</span>
                        </div>
                    </div>
                </article>

                <article class="portal-card" data-reveal>
                    <div class="portal-media portal-media-provider">
                        <span class="portal-media-badge portal-media-badge-right" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                <path d="M12 2.5 20 5.8v5.9c0 5.1-3.4 9.8-8 11.8-4.6-2-8-6.7-8-11.8V5.8L12 2.5Zm0 3.2L7 7.8v3.7c0 3.6 2.2 6.9 5 8.5 2.8-1.6 5-4.9 5-8.5V7.8l-5-2.1Zm-1 8.5 4.7-4.7 1.4 1.4L11 17.1l-3.2-3.2 1.4-1.4L11 14.2Z" />
                            </svg>
                        </span>
                        <img src="~/images/landing-provider-card.svg" alt="Ilustração de uma operação digital para profissionais parceiros." />
                    </div>
                    <div class="portal-body">
                        <div class="portal-heading-row">
                            <h2>Para Profissionais</h2>
                            <span class="partner-badge">Parceiro fundador</span>
                        </div>
                        <p>
                            Deseja ampliar sua base de clientes e profissionalizar seu negócio? Cadastre-se como
                            parceiro e tenha acesso a novas demandas com operação mais organizada.
                        </p>
                        <a class="btn btn-dark btn-block" href="@Model.ProviderPortalUrl">
                            Cadastrar-se como Parceiro
                            <span class="button-icon" aria-hidden="true">→</span>
                        </a>
                        <ul class="benefit-list" role="list">
                            <li>Pagamentos seguros</li>
                            <li>Novos clientes diários</li>
                        </ul>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section class="info-section" id="sobre">
        <div class="container">
            <div class="section-heading" data-reveal>
                <span class="section-kicker">Sobre a plataforma</span>
                <h2>Uma operação digital clara para cliente, parceiro e equipe interna.</h2>
                <p>
                    O ConsertaPraMim organiza o contato inicial, a agenda, a comunicação e o acompanhamento
                    pós-serviço sem depender de fluxo improvisado.
                </p>
            </div>

            <div class="info-grid">
                <article class="info-card" data-reveal>
                    <h3>Cliente com jornada simples</h3>
                    <p>Abra o pedido, acompanhe o andamento e fale com quem vai executar o serviço no mesmo fluxo.</p>
                </article>
                <article class="info-card" data-reveal>
                    <h3>Prestador com operação previsível</h3>
                    <p>Receba oportunidades, organize seus atendimentos e mantenha o seu perfil pronto para converter.</p>
                </article>
                <article class="info-card" data-reveal>
                    <h3>Admin com visibilidade real</h3>
                    <p>Monitore a jornada ponta a ponta com portal próprio, indicadores e acesso rápido à API.</p>
                </article>
            </div>
        </div>
    </section>

    <section class="contact-section" id="contato">
        <div class="container contact-shell" data-reveal>
            <div class="contact-copy">
                <span class="section-kicker">Contato e acessos</span>
                <h2>Escolha o ponto de entrada certo para cada perfil.</h2>
                <p>
                    A landing pública apresenta a plataforma e direciona cada público para o portal correto,
                    mantendo cliente, parceiro, operação e API em domínios separados.
                </p>
            </div>
            <div class="contact-links">
                <a href="@Model.ClientPortalUrl">Área do cliente</a>
                <a href="@Model.ProviderPortalUrl">Portal do prestador</a>
                <a href="@Model.AdminPortalUrl">Portal admin</a>
                <a href="@Model.ApiSwaggerUrl">Swagger API</a>
            </div>
        </div>
    </section>

    <section class="legal-section">
        <div class="container legal-grid">
            <article class="legal-card" id="termos" data-reveal>
                <h3>Termos de uso</h3>
                <p>A jornada pública da landing apenas direciona para os portais. Autenticação e regras operacionais seguem o perfil de acesso correspondente.</p>
            </article>
            <article class="legal-card" id="privacidade" data-reveal>
                <h3>Privacidade</h3>
                <p>A home pública não expõe dados sensíveis nem depende de sessão autenticada para funcionar. O site publica somente conteúdo institucional.</p>
            </article>
            <article class="legal-card legal-card-faq" id="faq" data-reveal>
                <h3>FAQ</h3>
                <details>
                    <summary>Preciso de login para acessar a landing?</summary>
                    <p>Não. A landing é pública e serve como página de entrada para cliente, prestador, admin e documentação da API.</p>
                </details>
                <details>
                    <summary>O domínio raiz redireciona para o www?</summary>
                    <p>Sim. O acesso por <code>consertapramim.com</code> redireciona para <code>https://www.consertapramim.com</code>.</p>
                </details>
            </article>
        </div>
    </section>
</main>
