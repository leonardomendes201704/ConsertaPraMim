@using ConsertaPraMim.Web.Landing.Models
@using ConsertaPraMim.Web.Landing.Services
@inject Microsoft.Extensions.Options.IOptions<LandingSiteOptions> SiteOptions
@{
    var siteOptions = SiteOptions.Value;
    var landingModel = ViewData.Model as LandingPageViewModel;
    var requestHost = Context?.Request?.Host.Host;
    var pageTitle = ViewData["Title"] as string ?? "ConsertaPraMim";
    var pageDescription = ViewData["Description"] as string ?? "Plataforma ConsertaPraMim";
    var canonicalUrl = ViewData["CanonicalUrl"] as string ?? LandingSiteOptions.NormalizeUrl(siteOptions.CanonicalUrl, "https://www.consertapramim.com");
    var openGraphTitle = ViewData["OpenGraphTitle"] as string ?? pageTitle;
    var openGraphDescription = ViewData["OpenGraphDescription"] as string ?? pageDescription;
    var openGraphImage = ViewData["OpenGraphImage"] as string ?? (canonicalUrl.TrimEnd('/') + "/og-logo-consertapramim.png");
    var openGraphUrl = ViewData["OpenGraphUrl"] as string ?? (canonicalUrl.TrimEnd('/') + "/");
    var openGraphType = ViewData["OpenGraphType"] as string ?? "website";
    var twitterCard = ViewData["TwitterCard"] as string ?? "summary_large_image";
    var initialLeadOrigin = ViewData["InitialLeadOrigin"] as string ?? landingModel?.InitialLeadOrigin ?? "";
    var landingVisitorId = ViewData["LandingVisitorId"] as string ?? landingModel?.VisitorId ?? "";
    var landingSessionId = ViewData["LandingSessionId"] as string ?? landingModel?.SessionId ?? "";
    var resolvedApiBaseUrl = landingModel?.ApiBaseUrl
        ?? LandingPublicUrlResolver.ResolveApiBaseUrl(
            siteOptions.ApiBaseUrl ?? siteOptions.ApiSwaggerUrl,
            requestHost,
            "https://api.consertapramim.com");
    var leadCaptureUrl = landingModel?.LeadCaptureUrl ?? $"{resolvedApiBaseUrl.TrimEnd('/')}/api/landing-leads/public";
    var analyticsConfigUrl = landingModel?.AnalyticsConfigUrl ?? $"{resolvedApiBaseUrl.TrimEnd('/')}/api/landing-analytics/public/config";
    var telemetryUrl = landingModel?.TelemetryUrl ?? $"{resolvedApiBaseUrl.TrimEnd('/')}/api/landing-analytics/public/events";
    var homeUrl = canonicalUrl.TrimEnd('/');
    var homeTopUrl = $"{homeUrl}/#top";
    var homeAboutUrl = $"{homeUrl}/#sobre";
    var homeAccessUrl = $"{homeUrl}/#acessos";
    var homeLeadUrl = $"{homeUrl}/Cliente";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <meta name="description" content="@pageDescription" />
    <link rel="canonical" href="@canonicalUrl" />
    <meta property="og:title" content="@openGraphTitle" />
    <meta property="og:description" content="@openGraphDescription" />
    <meta property="og:image" content="@openGraphImage" />
    <meta property="og:url" content="@openGraphUrl" />
    <meta property="og:type" content="@openGraphType" />
    <meta name="twitter:card" content="@twitterCard" />
    <meta name="twitter:title" content="@openGraphTitle" />
    <meta name="twitter:description" content="@openGraphDescription" />
    <meta name="twitter:image" content="@openGraphImage" />
    <meta name="theme-color" content="#0f5bbb" />
    <link rel="icon" type="image/png" sizes="512x512" href="~/og-logo-consertapramim.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/og-logo-consertapramim.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-lead-capture-url="@leadCaptureUrl" data-initial-lead-origin="@initialLeadOrigin" data-visitor-id="@landingVisitorId" data-session-id="@landingSessionId" data-analytics-config-url="@analyticsConfigUrl" data-telemetry-url="@telemetryUrl">
    <div class="site-shell">
        <header class="site-header">
            <div class="container nav-shell">
                <a class="brand" href="@homeTopUrl" aria-label="ConsertaPraMim">
                    <img class="brand-logo" src="~/images/logo-top-bar-consertapramim.png" alt="ConsertaPraMim" asp-append-version="true" />
                </a>
                <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
                <nav class="site-nav" id="site-nav" data-nav>
                    <a href="@homeTopUrl">Início</a>
                    <a href="@homeAboutUrl">Sobre</a>
                    <a href="@homeLeadUrl" data-lead-trigger="client">Contato</a>
                    <a class="nav-cta" href="@homeAccessUrl">Entrar</a>
                </nav>
            </div>
        </header>
        <div role="main">
            @RenderBody()
        </div>
        <footer class="site-footer">
            <div class="container footer-shell">
                <p>© @DateTime.UtcNow.Year ConsertaPraMim. Todos os direitos reservados.</p>
            </div>
        </footer>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
