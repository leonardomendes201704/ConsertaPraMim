@{
    Layout = "_Layout";
    ViewData["Title"] = "Cadastro de Prestador";
    var termsVersion = ViewBag.TermsVersion is int parsedTermsVersion ? parsedTermsVersion : 0;
    var termsTitle = ViewBag.TermsTitle as string ?? "Termo de Cadastro - Prestador";
    var termsHtml = ViewBag.TermsHtml as string;
    var termsError = ViewBag.TermsError as string;
    var hasTerms = !string.IsNullOrWhiteSpace(termsHtml) && termsVersion > 0;
}

<style>
    .terms-scroll {
        max-height: 230px;
        overflow-y: auto;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 1rem;
        font-size: 0.9rem;
        color: #334155;
    }
</style>

<div class="auth-container">
    <div class="container d-flex justify-content-center py-5">
        <div class="card auth-card p-4 shadow-lg border-0 my-4" style="max-width: 700px;">
            <div class="card-body">
                <div class="text-center mb-4">
                    <h2 class="fw-bold">Seja um Parceiro</h2>
                    <p class="text-muted">Comece a receber servicos hoje mesmo</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger border-0 shadow-sm mb-4">
                        @ViewBag.Error
                    </div>
                }

                <form asp-action="Register" method="post">
                    <input type="hidden" name="termsVersion" value="@termsVersion" />

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Nome Completo</label>
                            <input type="text" name="name" class="form-control border-light bg-light py-2" placeholder="Seu nome" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">E-mail Profissional</label>
                        <input type="email" name="email" class="form-control border-light bg-light py-2" placeholder="exemplo@email.com" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">WhatsApp de Contato</label>
                        <input id="registerPhone" type="tel" name="phone" class="form-control border-light bg-light py-2" inputmode="numeric" autocomplete="tel-national" maxlength="15" placeholder="(11) 99999-9999" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Criar Senha</label>
                        <input type="password" name="password" class="form-control border-light bg-light py-2" placeholder="Minimo 8 caracteres" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">@termsTitle (v@termsVersion)</label>
                        @if (!string.IsNullOrWhiteSpace(termsError))
                        {
                            <div class="alert alert-warning small rounded-4 border-0 mb-2">
                                Não foi possível carregar o termo de aceite. Atualize a página para tentar novamente.
                            </div>
                        }
                        else if (hasTerms)
                        {
                            <div class="terms-scroll">
                                @Html.Raw(termsHtml)
                            </div>
                        }
                    </div>

                    <div class="mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="termsAccepted" name="termsAccepted" value="true" required @(hasTerms ? "" : "disabled")>
                            <label class="form-check-label small text-muted" for="termsAccepted">
                                Li e aceito integralmente os termos acima, incluindo a cláusula de isenção de responsabilidade da plataforma.
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-3 fw-bold shadow-sm" @(hasTerms ? "" : "disabled")>
                        Criar Minha Conta
                    </button>

                    <div class="text-center mt-4">
                        <p class="text-muted mb-0">Ja tem cadastro? <a asp-action="Login" class="text-primary fw-bold text-decoration-none">Acesse aqui</a></p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const phoneInput = document.getElementById("registerPhone");
            if (!phoneInput) {
                return;
            }

            function formatPhone(value) {
                const digits = String(value || "").replace(/\D/g, "").slice(0, 11);
                if (digits.length <= 2) {
                    return digits;
                }

                if (digits.length <= 6) {
                    return `(${digits.slice(0, 2)}) ${digits.slice(2)}`;
                }

                if (digits.length <= 10) {
                    return `(${digits.slice(0, 2)}) ${digits.slice(2, 6)}-${digits.slice(6)}`;
                }

                return `(${digits.slice(0, 2)}) ${digits.slice(2, 7)}-${digits.slice(7)}`;
            }

            phoneInput.addEventListener("input", function () {
                phoneInput.value = formatPhone(phoneInput.value);
            });

            const form = phoneInput.closest("form");
            if (form) {
                form.addEventListener("submit", function () {
                    phoneInput.value = phoneInput.value.replace(/\D/g, "");
                });
            }

            phoneInput.value = formatPhone(phoneInput.value);
        })();
    </script>
}
