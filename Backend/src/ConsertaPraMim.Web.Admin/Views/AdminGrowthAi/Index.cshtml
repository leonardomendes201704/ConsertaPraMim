@model ConsertaPraMim.Web.Admin.Models.AdminGrowthAiViewModel
@{
    ViewData["Title"] = "AI Copilot Growth";

    TimeZoneInfo ResolveBusinessTimeZone()
    {
        var candidates = new[]
        {
            "America/Sao_Paulo",
            "E. South America Standard Time"
        };

        foreach (var candidate in candidates)
        {
            try
            {
                return TimeZoneInfo.FindSystemTimeZoneById(candidate);
            }
            catch (TimeZoneNotFoundException)
            {
            }
            catch (InvalidTimeZoneException)
            {
            }
        }

        return TimeZoneInfo.Utc;
    }

    var businessTimeZone = ResolveBusinessTimeZone();

    DateTime NormalizeUtc(DateTime value)
    {
        return value.Kind switch
        {
            DateTimeKind.Utc => value,
            DateTimeKind.Local => value.ToUniversalTime(),
            _ => DateTime.SpecifyKind(value, DateTimeKind.Utc)
        };
    }

    string FormatBusinessDateTime(DateTime value, string format = "dd/MM/yyyy HH:mm:ss")
    {
        var normalizedUtc = NormalizeUtc(value);
        return TimeZoneInfo.ConvertTimeFromUtc(normalizedUtc, businessTimeZone).ToString(format);
    }

    string FormatNullableBusinessDateTime(DateTime? value, string format = "dd/MM/yyyy HH:mm:ss")
    {
        return value.HasValue
            ? FormatBusinessDateTime(value.Value, format)
            : "-";
    }

    string BuildAnalysisOptionLabel(ConsertaPraMim.Application.DTOs.AdminGrowthAiAnalysisDto analysis)
    {
        var date = FormatBusinessDateTime(analysis.CreatedAtUtc, "dd/MM/yyyy HH:mm");
        var category = string.IsNullOrWhiteSpace(analysis.Category) ? "Todas categorias" : analysis.Category;
        var city = string.IsNullOrWhiteSpace(analysis.City) ? "Todas cidades" : analysis.City;
        return $"{date} | {category} | {city}";
    }
}

<style>
    .ai-latest-summary {
        border: 1px solid #dbeafe;
        border-left: 5px solid #2563eb;
        border-radius: .75rem;
        background: linear-gradient(135deg, #eff6ff 0%, #ffffff 70%);
        padding: 1rem;
    }

    .analysis-chip {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        border-radius: 999px;
        padding: .3rem .65rem;
        font-size: .78rem;
        font-weight: 600;
        border: 1px solid #dbeafe;
        background: #f8fbff;
        color: #1e3a8a;
    }

    .analysis-chip.neutral {
        border-color: #e2e8f0;
        background: #f8fafc;
        color: #334155;
    }

    .analysis-panel {
        height: 100%;
        border: 1px solid #e2e8f0;
        border-radius: .75rem;
        padding: .9rem;
        background: #fff;
    }

    .analysis-panel h3 {
        font-size: .95rem;
        margin-bottom: .6rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: .45rem;
    }

    .analysis-panel.funnel {
        background: #f8fbff;
        border-color: #dbeafe;
    }

    .analysis-panel.liquidity {
        background: #f5fcfb;
        border-color: #ccfbf1;
    }

    .analysis-panel.risks {
        background: #fff7f7;
        border-color: #fecaca;
    }

    .analysis-panel.actions {
        background: #f7fcf7;
        border-color: #dcfce7;
    }

    .analysis-list {
        margin-bottom: 0;
        padding-left: 1.1rem;
    }

    .analysis-list li + li {
        margin-top: .35rem;
    }

    .comparison-summary {
        border: 1px solid #e9d5ff;
        border-left: 5px solid #7c3aed;
        border-radius: .75rem;
        background: linear-gradient(135deg, #faf5ff 0%, #ffffff 70%);
        padding: 1rem;
    }

    .comparison-panel {
        height: 100%;
        border: 1px solid #e2e8f0;
        border-radius: .75rem;
        padding: .9rem;
        background: #fff;
    }

    .comparison-panel h3 {
        font-size: .95rem;
        margin-bottom: .6rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: .45rem;
    }

    .comparison-panel.improvements {
        background: #f7fcf7;
        border-color: #dcfce7;
    }

    .comparison-panel.regressions {
        background: #fff7f7;
        border-color: #fecaca;
    }

    .comparison-panel.stable {
        background: #f8fbff;
        border-color: #dbeafe;
    }

    .comparison-panel.actions {
        background: #faf5ff;
        border-color: #e9d5ff;
    }
</style>

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h1 class="h4 fw-bold mb-1">AI Copilot Growth</h1>
        <p class="text-muted mb-0">Analise assistida de growth funnel e score de liquidez para decisao executiva.</p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
        <span class="text-muted small">
            Atualizado em @FormatBusinessDateTime(Model.LastUpdatedUtc)
        </span>
        <button type="button" class="btn btn-outline-dark btn-sm" data-bs-toggle="modal" data-bs-target="#openAiSettingsModal">
            <i class="fas fa-gear me-1"></i> Configuracao OpenAI
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="row g-3">
    <div class="col-12">
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header bg-white">
                <h2 class="h6 fw-semibold mb-0">Executar analise IA</h2>
            </div>
            <div class="card-body">
                <form asp-action="RunAnalysis" method="post" class="d-grid gap-3">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label asp-for="AnalyzeForm.FromUtc" class="form-label">De (UTC)</label>
                            <input asp-for="AnalyzeForm.FromUtc" type="datetime-local" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AnalyzeForm.ToUtc" class="form-label">Ate (UTC)</label>
                            <input asp-for="AnalyzeForm.ToUtc" type="datetime-local" class="form-control" />
                        </div>
                    </div>

                    <div class="row g-2">
                        <div class="col-md-4">
                            <label asp-for="AnalyzeForm.Category" class="form-label">Categoria</label>
                            <input asp-for="AnalyzeForm.Category" class="form-control" placeholder="Ex.: Electrical" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="AnalyzeForm.City" class="form-label">Cidade</label>
                            <input asp-for="AnalyzeForm.City" class="form-control" placeholder="Ex.: Campinas" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="AnalyzeForm.LiquidityTake" class="form-label">Top regioes</label>
                            <input asp-for="AnalyzeForm.LiquidityTake" class="form-control" type="number" min="5" max="100" />
                        </div>
                    </div>

                    <div class="row g-2">
                        <div class="col-md-6">
                            <label asp-for="AnalyzeForm.ProposalSlaMinutes" class="form-label">SLA 1a proposta (min)</label>
                            <input asp-for="AnalyzeForm.ProposalSlaMinutes" class="form-control" type="number" min="5" max="720" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AnalyzeForm.AcceptanceSlaHours" class="form-label">SLA aceite (h)</label>
                            <input asp-for="AnalyzeForm.AcceptanceSlaHours" class="form-control" type="number" min="1" max="168" />
                        </div>
                    </div>

                    <div>
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-wand-magic-sparkles me-1"></i>Gerar analise IA
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white d-flex justify-content-between align-items-center gap-2 flex-wrap">
                <h2 class="h6 fw-semibold mb-0"><i class="fas fa-sparkles me-1 text-primary"></i>Ultima analise</h2>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    @if (Model.LatestAnalysis != null)
                    {
                        <span class="badge text-bg-light">@FormatBusinessDateTime(Model.LatestAnalysis.CreatedAtUtc)</span>
                    }
                    @if (Model.Snapshot != null && Model.Snapshot.RecentAnalyses.Count >= 2)
                    {
                        <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#compareAnalysesModal">
                            <i class="fas fa-code-compare me-1"></i>Comparar analises
                        </button>
                    }
                </div>
            </div>
            <div class="card-body">
                @if (Model.LatestAnalysis == null)
                {
                    <div class="text-muted">Nenhuma analise registrada ate o momento.</div>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="analysis-chip"><i class="fas fa-robot"></i>@Model.LatestAnalysis.Model</span>
                        @if (Model.LatestAnalysis.TotalTokens.HasValue)
                        {
                            <span class="analysis-chip neutral"><i class="fas fa-gauge-high"></i>@Model.LatestAnalysis.TotalTokens.Value tokens</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.LatestAnalysis.Category))
                        {
                            <span class="analysis-chip neutral"><i class="fas fa-tag"></i>@Model.LatestAnalysis.Category</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.LatestAnalysis.City))
                        {
                            <span class="analysis-chip neutral"><i class="fas fa-location-dot"></i>@Model.LatestAnalysis.City</span>
                        }
                    </div>

                    <div class="ai-latest-summary mb-3">
                        <div class="small text-uppercase text-primary fw-semibold mb-1">Resumo executivo</div>
                        <p class="mb-0">@Model.LatestAnalysis.ExecutiveSummary</p>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <section class="analysis-panel funnel">
                                <h3><i class="fas fa-filter text-primary"></i>Insights de funil</h3>
                                @if (Model.LatestAnalysis.FunnelInsights.Count == 0)
                                {
                                    <div class="text-muted small">Sem insights de funil nesta execucao.</div>
                                }
                                else
                                {
                                    <ul class="analysis-list">
                                        @foreach (var item in Model.LatestAnalysis.FunnelInsights)
                                        {
                                            <li>@item</li>
                                        }
                                    </ul>
                                }
                            </section>
                        </div>
                        <div class="col-md-6">
                            <section class="analysis-panel liquidity">
                                <h3><i class="fas fa-droplet text-info"></i>Insights de liquidez</h3>
                                @if (Model.LatestAnalysis.LiquidityInsights.Count == 0)
                                {
                                    <div class="text-muted small">Sem insights de liquidez nesta execucao.</div>
                                }
                                else
                                {
                                    <ul class="analysis-list">
                                        @foreach (var item in Model.LatestAnalysis.LiquidityInsights)
                                        {
                                            <li>@item</li>
                                        }
                                    </ul>
                                }
                            </section>
                        </div>
                        <div class="col-md-6">
                            <section class="analysis-panel risks">
                                <h3><i class="fas fa-triangle-exclamation text-danger"></i>Riscos</h3>
                                @if (Model.LatestAnalysis.Risks.Count == 0)
                                {
                                    <div class="text-muted small">Sem riscos relevantes sinalizados nesta execucao.</div>
                                }
                                else
                                {
                                    <ul class="analysis-list">
                                        @foreach (var item in Model.LatestAnalysis.Risks)
                                        {
                                            <li>@item</li>
                                        }
                                    </ul>
                                }
                            </section>
                        </div>
                        <div class="col-md-6">
                            <section class="analysis-panel actions">
                                <h3><i class="fas fa-list-check text-success"></i>Acoes recomendadas</h3>
                                @if (Model.LatestAnalysis.RecommendedActions.Count == 0)
                                {
                                    <div class="text-muted small">Sem acoes recomendadas nesta execucao.</div>
                                }
                                else
                                {
                                    <ul class="analysis-list">
                                        @foreach (var item in Model.LatestAnalysis.RecommendedActions)
                                        {
                                            <li>@item</li>
                                        }
                                    </ul>
                                }
                            </section>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="openAiSettingsModal" tabindex="-1" aria-labelledby="openAiSettingsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="openAiSettingsModalLabel">
                    <i class="fas fa-gear me-2 text-primary"></i>Configuracao OpenAI
                </h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <form asp-action="SaveSettings" method="post">
                <div class="modal-body d-grid gap-3">
                    <div class="form-check form-switch">
                        <input asp-for="SettingsForm.Enabled" class="form-check-input" />
                        <label asp-for="SettingsForm.Enabled" class="form-check-label">Copiloto habilitado</label>
                    </div>

                    <div class="row g-2">
                        <div class="col-md-8">
                            <label asp-for="SettingsForm.Model" class="form-label">Modelo</label>
                            <input asp-for="SettingsForm.Model" class="form-control" placeholder="gpt-4.1-mini" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SettingsForm.Temperature" class="form-label">Temperature</label>
                            <input asp-for="SettingsForm.Temperature" class="form-control" type="number" step="0.01" min="0" max="1" />
                        </div>
                    </div>

                    <div class="row g-2">
                        <div class="col-md-6">
                            <label asp-for="SettingsForm.MaxOutputTokens" class="form-label">Max tokens</label>
                            <input asp-for="SettingsForm.MaxOutputTokens" class="form-control" type="number" min="200" max="4000" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Status API key</label>
                            <div class="form-control bg-light">
                                @if (Model.SettingsForm.IsConfigured)
                                {
                                    <span class="text-success fw-semibold">Configurada (@Model.SettingsForm.ApiKeyMasked)</span>
                                }
                                else
                                {
                                    <span class="text-danger fw-semibold">Nao configurada</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div>
                        <label asp-for="SettingsForm.ApiKey" class="form-label">OpenAI API key</label>
                        <input asp-for="SettingsForm.ApiKey" class="form-control" type="password" autocomplete="off" placeholder="Deixe em branco para manter a atual" />
                        <div class="form-text">A chave e mascarada no retorno e nunca exibida em texto aberto.</div>
                    </div>

                    <div>
                        <label asp-for="SettingsForm.SystemPrompt" class="form-label">System prompt</label>
                        <textarea asp-for="SettingsForm.SystemPrompt" class="form-control" rows="6"></textarea>
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        @if (Model.SettingsForm.UpdatedAtUtc.HasValue)
                        {
                            <span class="badge text-bg-light">Atualizado: @FormatNullableBusinessDateTime(Model.SettingsForm.UpdatedAtUtc)</span>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-floppy-disk me-1"></i>Salvar configuracao
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.LatestComparison != null)
{
    var comparisonBaseAnalysis = Model.Snapshot?.RecentAnalyses.FirstOrDefault(item => item.AnalysisId == Model.LatestComparison.BaseAnalysisId);
    var comparisonTargetAnalysis = Model.Snapshot?.RecentAnalyses.FirstOrDefault(item => item.AnalysisId == Model.LatestComparison.TargetAnalysisId);
    var comparisonBaseLabel = comparisonBaseAnalysis == null
        ? Model.LatestComparison.BaseLabel
        : BuildAnalysisOptionLabel(comparisonBaseAnalysis);
    var comparisonTargetLabel = comparisonTargetAnalysis == null
        ? Model.LatestComparison.TargetLabel
        : BuildAnalysisOptionLabel(comparisonTargetAnalysis);

    <div class="card shadow-sm border-0 mt-3">
        <div class="card-header bg-white d-flex justify-content-between align-items-center gap-2 flex-wrap">
            <h2 class="h6 fw-semibold mb-0"><i class="fas fa-code-compare me-1 text-primary"></i>Comparativo entre analises</h2>
            <div class="d-flex gap-2 flex-wrap">
                <span class="analysis-chip neutral"><i class="fas fa-arrow-down-short-wide"></i>Base: @comparisonBaseLabel</span>
                <span class="analysis-chip neutral"><i class="fas fa-arrow-up-short-wide"></i>Atual: @comparisonTargetLabel</span>
                @if (Model.LatestComparison.TotalTokens.HasValue)
                {
                    <span class="analysis-chip neutral"><i class="fas fa-gauge-high"></i>@Model.LatestComparison.TotalTokens.Value tokens</span>
                }
            </div>
        </div>
        <div class="card-body">
            <div class="comparison-summary mb-3">
                <div class="small text-uppercase fw-semibold text-primary mb-1">Resumo do delta</div>
                <p class="mb-0">@Model.LatestComparison.ExecutiveDeltaSummary</p>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <section class="comparison-panel improvements">
                        <h3><i class="fas fa-circle-arrow-up text-success"></i>Melhorias</h3>
                        @if (Model.LatestComparison.Improvements.Count == 0)
                        {
                            <div class="text-muted small">Nenhuma melhoria relevante identificada.</div>
                        }
                        else
                        {
                            <ul class="analysis-list">
                                @foreach (var item in Model.LatestComparison.Improvements)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        }
                    </section>
                </div>
                <div class="col-md-6">
                    <section class="comparison-panel regressions">
                        <h3><i class="fas fa-triangle-exclamation text-danger"></i>Regressoes</h3>
                        @if (Model.LatestComparison.Regressions.Count == 0)
                        {
                            <div class="text-muted small">Nenhuma regressao sinalizada.</div>
                        }
                        else
                        {
                            <ul class="analysis-list">
                                @foreach (var item in Model.LatestComparison.Regressions)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        }
                    </section>
                </div>
                <div class="col-md-6">
                    <section class="comparison-panel stable">
                        <h3><i class="fas fa-equals text-info"></i>Sinais estaveis</h3>
                        @if (Model.LatestComparison.StableSignals.Count == 0)
                        {
                            <div class="text-muted small">Sem sinais estaveis relevantes nesta comparacao.</div>
                        }
                        else
                        {
                            <ul class="analysis-list">
                                @foreach (var item in Model.LatestComparison.StableSignals)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        }
                    </section>
                </div>
                <div class="col-md-6">
                    <section class="comparison-panel actions">
                        <h3><i class="fas fa-list-check text-primary"></i>Acoes prioritarias</h3>
                        @if (Model.LatestComparison.PriorityActions.Count == 0)
                        {
                            <div class="text-muted small">Sem acoes prioritarias sugeridas nesta comparacao.</div>
                        }
                        else
                        {
                            <ul class="analysis-list">
                                @foreach (var item in Model.LatestComparison.PriorityActions)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        }
                    </section>
                </div>
            </div>
        </div>
    </div>
}

@if (Model.Snapshot != null && Model.Snapshot.RecentAnalyses.Count > 0)
{
    <div class="card shadow-sm border-0 mt-3">
        <div class="card-header bg-white">
            <h2 class="h6 fw-semibold mb-0">Historico recente</h2>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Data</th>
                        <th>Recorte</th>
                        <th>Resumo</th>
                        <th>Modelo</th>
                        <th>Tokens</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var analysis in Model.Snapshot.RecentAnalyses.Take(10))
                {
                    <tr>
                        <td>@FormatBusinessDateTime(analysis.CreatedAtUtc)</td>
                        <td>
                            <div class="small">
                                <div><strong>Categoria:</strong> @(string.IsNullOrWhiteSpace(analysis.Category) ? "-" : analysis.Category)</div>
                                <div><strong>Cidade:</strong> @(string.IsNullOrWhiteSpace(analysis.City) ? "-" : analysis.City)</div>
                            </div>
                        </td>
                        <td>@analysis.ExecutiveSummary</td>
                        <td>@analysis.Model</td>
                        <td>@(analysis.TotalTokens?.ToString() ?? "-")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.Snapshot != null && Model.Snapshot.RecentAnalyses.Count >= 2)
{
    <div class="modal fade" id="compareAnalysesModal" tabindex="-1" aria-labelledby="compareAnalysesModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="compareAnalysesModalLabel"><i class="fas fa-code-compare me-2 text-primary"></i>Comparar analises IA</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <form asp-action="RunComparison" method="post">
                    <div class="modal-body">
                        <p class="text-muted mb-3">Selecione uma analise de referencia (base) e uma analise mais recente (atual) para gerar o comparativo com IA.</p>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="CompareForm.BaseAnalysisId" class="form-label">Analise base</label>
                                <select asp-for="CompareForm.BaseAnalysisId" class="form-select">
                                    <option value="">Selecione</option>
                                    @foreach (var item in Model.Snapshot.RecentAnalyses.OrderByDescending(x => x.CreatedAtUtc))
                                    {
                                        <option value="@item.AnalysisId">@BuildAnalysisOptionLabel(item)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CompareForm.TargetAnalysisId" class="form-label">Analise atual</label>
                                <select asp-for="CompareForm.TargetAnalysisId" class="form-select">
                                    <option value="">Selecione</option>
                                    @foreach (var item in Model.Snapshot.RecentAnalyses.OrderByDescending(x => x.CreatedAtUtc))
                                    {
                                        <option value="@item.AnalysisId">@BuildAnalysisOptionLabel(item)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-sparkles me-1"></i>Gerar comparativo IA
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
