@model ConsertaPraMim.Web.Admin.Models.AdminWikiViewModel
@{
    ViewData["Title"] = "Wiki Docs";
    var selectedDocument = Model.SelectedDocument;
}

@functions {
    private static string FormatFileSize(long sizeBytes)
    {
        if (sizeBytes < 1024)
        {
            return $"{sizeBytes} B";
        }

        var sizeKb = sizeBytes / 1024d;
        if (sizeKb < 1024)
        {
            return $"{sizeKb:0.##} KB";
        }

        var sizeMb = sizeKb / 1024d;
        return $"{sizeMb:0.##} MB";
    }
}

@section Styles {
    <style>
        .wiki-layout {
            display: grid;
            grid-template-columns: minmax(300px, 360px) minmax(0, 1fr);
            gap: 16px;
            min-height: calc(100vh - 190px);
        }

        .wiki-panel {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            box-shadow: 0 10px 24px rgba(15, 23, 42, .06);
            overflow: hidden;
        }

        .wiki-sidebar-header {
            padding: 14px 14px 10px;
            border-bottom: 1px solid #e5e7eb;
        }

        .wiki-sidebar-body {
            max-height: calc(100vh - 300px);
            overflow-y: auto;
            padding: 10px;
        }

        .wiki-section-title {
            font-size: .76rem;
            font-weight: 700;
            color: #64748b;
            letter-spacing: .04em;
            padding: 6px 8px;
            text-transform: uppercase;
        }

        .wiki-doc-link {
            border-radius: 10px;
            border: 0;
            margin-bottom: 4px;
            padding: 8px 10px;
        }

        .wiki-doc-link.active {
            background: #eff6ff;
            border-left: 3px solid #2563eb;
        }

        .wiki-doc-title {
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 2px;
        }

        .wiki-doc-path {
            font-size: .78rem;
            color: #64748b;
            word-break: break-word;
        }

        .wiki-reader-header {
            padding: 14px 16px;
            border-bottom: 1px solid #e5e7eb;
            background: linear-gradient(135deg, #f8fafc 0%, #eef2ff 100%);
        }

        .wiki-reader-body {
            padding: 18px;
            max-height: calc(100vh - 300px);
            overflow-y: auto;
        }

        .wiki-markdown-content h1,
        .wiki-markdown-content h2,
        .wiki-markdown-content h3 {
            margin-top: 1.1rem;
            margin-bottom: .6rem;
            color: #0f172a;
        }

        .wiki-markdown-content h1 {
            font-size: 1.55rem;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: .35rem;
        }

        .wiki-markdown-content h2 {
            font-size: 1.25rem;
        }

        .wiki-markdown-content h3 {
            font-size: 1.08rem;
        }

        .wiki-markdown-content p,
        .wiki-markdown-content li {
            color: #1f2937;
            line-height: 1.6;
        }

        .wiki-markdown-content code {
            background: #f1f5f9;
            padding: .1rem .35rem;
            border-radius: 6px;
        }

        .wiki-markdown-content pre {
            background: #0f172a;
            color: #e2e8f0;
            border-radius: 10px;
            padding: 12px;
            overflow: auto;
        }

        .wiki-markdown-content pre code {
            background: transparent;
            color: inherit;
            padding: 0;
        }

        .wiki-markdown-content table {
            width: 100%;
            border-collapse: collapse;
            margin: 1rem 0;
        }

        .wiki-markdown-content th,
        .wiki-markdown-content td {
            border: 1px solid #e5e7eb;
            padding: .55rem .65rem;
            vertical-align: top;
        }

        .wiki-markdown-content th {
            background: #f8fafc;
            font-weight: 700;
        }

        @@media (max-width: 1200px) {
            .wiki-layout {
                grid-template-columns: 1fr;
            }

            .wiki-sidebar-body,
            .wiki-reader-body {
                max-height: none;
            }
        }
    </style>
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h3 class="mb-1">Wiki Docs</h3>
        <p class="text-muted mb-0">
            Leitura centralizada dos arquivos markdown versionados em <code>Documentacao</code>.
        </p>
    </div>
    <div class="text-end small text-muted">
        <div><strong>Total docs:</strong> @Model.TotalDocuments</div>
        <div><strong>Atualizado:</strong> @Model.GeneratedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-warning mb-3">
        <i class="fas fa-triangle-exclamation me-2"></i>@Model.ErrorMessage
    </div>
}

<div class="wiki-layout">
    <section class="wiki-panel">
        <div class="wiki-sidebar-header">
            <label for="wikiSearchInput" class="form-label fw-semibold mb-1">Buscar documento</label>
            <input id="wikiSearchInput" type="text" class="form-control" placeholder="Titulo, pasta ou arquivo..." autocomplete="off" />
            <div class="small text-muted mt-2 text-break">
                <i class="fas fa-folder-tree me-1"></i>Raiz: <code>@Model.DocumentationRootPath</code>
            </div>
        </div>
        <div class="wiki-sidebar-body" id="wikiSidebarBody">
            @foreach (var wikiSection in Model.Sections)
            {
                <div class="wiki-section mb-2" data-section-name="@wikiSection.Name.ToLowerInvariant()">
                    <div class="wiki-section-title">@wikiSection.Name</div>
                    <div>
                        @foreach (var document in wikiSection.Documents)
                        {
                            var isActive = string.Equals(Model.SelectedDocumentPath, document.RelativePath, StringComparison.OrdinalIgnoreCase);
                            <a asp-controller="AdminWiki"
                               asp-action="Index"
                               asp-route-doc="@document.RelativePath"
                               class="list-group-item list-group-item-action wiki-doc-link @(isActive ? "active" : "")"
                               data-title="@document.Title.ToLowerInvariant()"
                               data-path="@document.RelativePath.ToLowerInvariant()">
                                <div class="wiki-doc-title">@document.Title</div>
                                <div class="wiki-doc-path">@document.RelativePath</div>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="wiki-panel">
        @if (selectedDocument == null)
        {
            <div class="p-4 text-muted">
                Nenhum documento selecionado.
            </div>
        }
        else
        {
            <div class="wiki-reader-header">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                    <div>
                        <h4 class="mb-1">@selectedDocument.Title</h4>
                        <div class="small text-muted text-break">
                            <i class="fas fa-file-lines me-1"></i>@selectedDocument.RelativePath
                        </div>
                    </div>
                    <div class="small text-muted text-end">
                        <div><strong>Ultima atualizacao:</strong> @selectedDocument.LastModifiedUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</div>
                        <div><strong>Tamanho:</strong> @FormatFileSize(selectedDocument.FileSizeBytes)</div>
                    </div>
                </div>
            </div>
            <div class="wiki-reader-body">
                <article class="wiki-markdown-content">
                    @Html.Raw(selectedDocument.HtmlContent)
                </article>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            const input = document.getElementById('wikiSearchInput');
            if (!input) {
                return;
            }

            const links = Array.from(document.querySelectorAll('.wiki-doc-link'));
            const sections = Array.from(document.querySelectorAll('.wiki-section'));

            input.addEventListener('input', () => {
                const term = input.value.trim().toLowerCase();

                for (const link of links) {
                    const title = link.dataset.title || '';
                    const path = link.dataset.path || '';
                    const visible = term.length === 0 || title.includes(term) || path.includes(term);
                    link.classList.toggle('d-none', !visible);
                }

                for (const section of sections) {
                    const hasVisible = section.querySelector('.wiki-doc-link:not(.d-none)') !== null;
                    section.classList.toggle('d-none', !hasVisible);
                }
            });
        })();
    </script>
}
