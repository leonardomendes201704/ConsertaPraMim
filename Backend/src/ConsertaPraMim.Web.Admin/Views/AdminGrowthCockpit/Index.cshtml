@using System.Globalization
@model ConsertaPraMim.Web.Admin.Models.AdminGrowthCockpitViewModel
@{
    ViewData["Title"] = "Cockpit Growth";
    var filters = Model.Filters;
    var cockpit = Model.Cockpit;
    var fromValue = filters.FromUtc?.ToString("yyyy-MM-dd") ?? string.Empty;
    var toValue = filters.ToUtc?.ToString("yyyy-MM-dd") ?? string.Empty;
    var categoryValue = filters.Category ?? string.Empty;
    var cityValue = filters.City ?? string.Empty;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h4 fw-bold mb-1">Cockpit Executivo de Growth</h1>
        <p class="text-muted mb-0">North Star, metas trimestrais, KPIs e tendencia semanal de conversao.</p>
    </div>
    <div class="text-muted small">
        Atualizado em @Model.LastUpdatedUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-12 col-md-2">
                <label class="form-label form-label-sm text-muted">De (UTC)</label>
                <input type="date" class="form-control" name="fromUtc" value="@fromValue" />
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label form-label-sm text-muted">Ate (UTC)</label>
                <input type="date" class="form-control" name="toUtc" value="@toValue" />
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label form-label-sm text-muted">Categoria</label>
                <input type="text" class="form-control" name="category" value="@categoryValue" placeholder="Ex.: Eletrica" />
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label form-label-sm text-muted">Cidade</label>
                <input type="text" class="form-control" name="city" value="@cityValue" placeholder="Ex.: Campinas" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label form-label-sm text-muted">SLA 1a proposta (min)</label>
                <input type="number" class="form-control" min="5" max="720" name="proposalSlaMinutes" value="@filters.ProposalSlaMinutes" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label form-label-sm text-muted">SLA aceite (h)</label>
                <input type="number" class="form-control" min="1" max="168" name="acceptanceSlaHours" value="@filters.AcceptanceSlaHours" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label form-label-sm text-muted">Janela North Star (h)</label>
                <input type="number" class="form-control" min="24" max="240" name="northStarResolutionHours" value="@filters.NorthStarResolutionHours" />
            </div>
            <div class="col-12 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-filter me-1"></i> Aplicar filtros
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-eraser me-1"></i> Limpar
                </a>
            </div>
        </form>
    </div>
</div>

@if (Model.HasError)
{
    <div class="alert alert-danger">
        <i class="fas fa-circle-exclamation me-2"></i>@Model.ErrorMessage
    </div>
}
else if (cockpit == null)
{
    <div class="alert alert-info">Carregando cockpit executivo...</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-12 col-xl-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">@cockpit.NorthStarName</div>
                    <div class="display-5 fw-bold">@cockpit.NorthStarRatePercent.ToString("0.##", CultureInfo.InvariantCulture)%</div>
                    <div class="small text-muted mb-3">@cockpit.NorthStarFormula</div>
                    <div class="small">
                        <span class="fw-semibold">@cockpit.NorthStarNumerator</span> de
                        <span class="fw-semibold">@cockpit.NorthStarDenominator</span> pedidos converteram em ate
                        <span class="fw-semibold">@cockpit.NorthStarResolutionHours h</span>.
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-xl-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white">
                    <h2 class="h6 fw-semibold mb-0">Metas trimestrais</h2>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                            <tr>
                                <th class="ps-3">Trimestre</th>
                                <th>Meta</th>
                                <th>Atual</th>
                                <th class="pe-3">Status</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var target in cockpit.QuarterTargets)
                            {
                                var badgeClass = target.Status.Equals("on_track", StringComparison.OrdinalIgnoreCase)
                                    ? "bg-success-subtle text-success-emphasis"
                                    : target.Status.Equals("attention", StringComparison.OrdinalIgnoreCase)
                                        ? "bg-warning-subtle text-warning-emphasis"
                                        : "bg-light text-secondary";
                                <tr>
                                    <td class="ps-3">@target.QuarterCode</td>
                                    <td>@target.TargetPercent.ToString("0.##", CultureInfo.InvariantCulture)%</td>
                                    <td>@target.CurrentPercent.ToString("0.##", CultureInfo.InvariantCulture)%</td>
                                    <td class="pe-3"><span class="badge @badgeClass">@target.Status</span></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        @foreach (var kpi in cockpit.Kpis)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted small text-uppercase">@kpi.Label</div>
                        <div class="h3 fw-bold mb-1">@kpi.Value.ToString("0.##", CultureInfo.InvariantCulture)@kpi.Unit</div>
                        <div class="small text-muted">@kpi.Description</div>
                        @if (kpi.TargetValue.HasValue)
                        {
                            <div class="small mt-2">Meta: <span class="fw-semibold">@kpi.TargetValue.Value.ToString("0.##", CultureInfo.InvariantCulture)@kpi.Unit</span></div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
            <h2 class="h6 fw-semibold mb-0">Tendencia semanal</h2>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm mb-0 align-middle">
                    <thead>
                    <tr>
                        <th class="ps-3">Semana (inicio UTC)</th>
                        <th>Pedidos</th>
                        <th>Com proposta</th>
                        <th>Aceitos</th>
                        <th>Agendado+</th>
                        <th class="pe-3">North Star</th>
                    </tr>
                    </thead>
                    <tbody>
                    @if (cockpit.WeeklyTrend.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-3">Sem dados na janela selecionada.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var week in cockpit.WeeklyTrend)
                        {
                            <tr>
                                <td class="ps-3">@week.WeekStartUtc.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                <td>@week.RequestsOpened</td>
                                <td>@week.RequestsWithProposal</td>
                                <td>@week.RequestsAccepted</td>
                                <td>@week.RequestsScheduledOrBeyond</td>
                                <td class="pe-3 fw-semibold">@week.NorthStarRatePercent.ToString("0.##", CultureInfo.InvariantCulture)%</td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-12 col-xl-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h2 class="h6 fw-semibold mb-0">Ritual semanal (agenda + owners)</h2>
                    <span class="text-muted small">Task ST-051.3</span>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(Model.WeeklyRitualErrorMessage))
                    {
                        <div class="alert alert-warning mb-0">@Model.WeeklyRitualErrorMessage</div>
                    }
                    else if (Model.WeeklyRitualSnapshot == null)
                    {
                        <div class="alert alert-light mb-0">Ritual semanal indisponivel no momento.</div>
                    }
                    else
                    {
                        <div class="small text-muted mb-2">
                            Semana de referencia: @Model.WeeklyRitualSnapshot.WeekStartUtc.ToLocalTime().ToString("dd/MM/yyyy")
                        </div>
                        <ol class="mb-0 ps-3">
                            @foreach (var item in Model.WeeklyRitualSnapshot.Agenda.OrderBy(agenda => agenda.Order))
                            {
                                <li class="mb-2">
                                    <div class="fw-semibold">@item.Topic</div>
                                    <div class="small text-muted">Owner: @item.OwnerRole</div>
                                    <div class="small">@item.Objective</div>
                                </li>
                            }
                        </ol>
                    }
                </div>
            </div>
        </div>
        <div class="col-12 col-xl-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white">
                    <h2 class="h6 fw-semibold mb-0">Ata semanal</h2>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(Model.WeeklyRitualFeedbackMessage))
                    {
                        <div class="alert @(Model.WeeklyRitualFeedbackSuccess ? "alert-success" : "alert-danger")">
                            @Model.WeeklyRitualFeedbackMessage
                        </div>
                    }
                    <form method="post" asp-action="RecordWeeklyRitual" class="row g-2">
                        <input type="hidden" name="fromUtc" value="@fromValue" />
                        <input type="hidden" name="toUtc" value="@toValue" />
                        <input type="hidden" name="category" value="@categoryValue" />
                        <input type="hidden" name="city" value="@cityValue" />
                        <input type="hidden" name="proposalSlaMinutes" value="@filters.ProposalSlaMinutes" />
                        <input type="hidden" name="acceptanceSlaHours" value="@filters.AcceptanceSlaHours" />
                        <input type="hidden" name="northStarResolutionHours" value="@filters.NorthStarResolutionHours" />

                        <div class="col-12">
                            <label class="form-label form-label-sm text-muted">Resumo da semana</label>
                            <textarea name="summary" rows="2" class="form-control" placeholder="Contexto executivo da semana"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label form-label-sm text-muted">Decisoes tomadas</label>
                            <textarea name="decisions" rows="2" class="form-control" placeholder="Decisoes aprovadas no ritual"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label form-label-sm text-muted">Owners e acoes</label>
                            <textarea name="ownerActions" rows="2" class="form-control" placeholder="Owner -> acao -> prazo"></textarea>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label form-label-sm text-muted">Riscos</label>
                            <textarea name="risks" rows="2" class="form-control" placeholder="Riscos e mitigacoes"></textarea>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label form-label-sm text-muted">Proximos passos</label>
                            <textarea name="nextActions" rows="2" class="form-control" placeholder="Plano para os proximos 7 dias"></textarea>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-outline-primary">
                                <i class="fas fa-file-circle-check me-1"></i> Registrar ata semanal
                            </button>
                        </div>
                    </form>

                    @if (Model.WeeklyRitualSnapshot?.RecentRecords?.Count > 0)
                    {
                        <hr />
                        <h3 class="h6 fw-semibold mb-2">Atas recentes</h3>
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead>
                                <tr>
                                    <th>Data</th>
                                    <th>Owner</th>
                                    <th>Resumo</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var record in Model.WeeklyRitualSnapshot.RecentRecords.Take(5))
                                {
                                    <tr>
                                        <td>@record.CreatedAtUtc.ToLocalTime().ToString("dd/MM HH:mm")</td>
                                        <td>@record.ActorEmail</td>
                                        <td>@record.Summary</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="h6 fw-semibold mb-0">Roadmap integrado de entrega</h2>
                        <div class="small text-muted">Task ST-051.4</div>
                    </div>
                    <a asp-controller="AdminRoadmap" asp-action="Index" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-road me-1"></i> Abrir roadmap completo
                    </a>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(Model.RoadmapErrorMessage))
                    {
                        <div class="alert alert-warning mb-0">@Model.RoadmapErrorMessage</div>
                    }
                    else if (Model.RoadmapSnapshot == null)
                    {
                        <div class="alert alert-light mb-0">Snapshot do roadmap indisponivel no momento.</div>
                    }
                    else
                    {
                        var roadmap = Model.RoadmapSnapshot;
                        <div class="row g-2 mb-3">
                            <div class="col-6 col-md-3">
                                <div class="border rounded p-2 h-100">
                                    <div class="text-muted small text-uppercase">Stories</div>
                                    <div class="h5 mb-0">@roadmap.TotalStories</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="border rounded p-2 h-100">
                                    <div class="text-muted small text-uppercase">Backlog</div>
                                    <div class="h5 mb-0">@roadmap.BacklogStories</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="border rounded p-2 h-100">
                                    <div class="text-muted small text-uppercase">In Progress</div>
                                    <div class="h5 mb-0">@roadmap.InProgressStories</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="border rounded p-2 h-100">
                                    <div class="text-muted small text-uppercase">Done</div>
                                    <div class="h5 mb-0">@roadmap.DoneStories</div>
                                </div>
                            </div>
                        </div>
                        <div class="small mb-3">
                            Taxa de entrega: <span class="fw-semibold">@roadmap.DeliveryRatePercent.ToString("0.##", CultureInfo.InvariantCulture)%</span>
                            | Em execucao: <span class="fw-semibold">@roadmap.InProgressRatePercent.ToString("0.##", CultureInfo.InvariantCulture)%</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                <tr>
                                    <th>Story</th>
                                    <th>Status</th>
                                    <th>Epic</th>
                                    <th>Trilha</th>
                                    <th>Tarefas</th>
                                    <th class="text-end">Detalhes</th>
                                </tr>
                                </thead>
                                <tbody>
                                @if (roadmap.PriorityStories.Count == 0)
                                {
                                    <tr>
                                        <td colspan="6" class="text-muted text-center py-3">Nenhuma story prioritaria encontrada.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var story in roadmap.PriorityStories)
                                    {
                                        var statusClass = story.Status.Equals("In Progress", StringComparison.OrdinalIgnoreCase)
                                            ? "bg-warning-subtle text-warning-emphasis"
                                            : "bg-secondary-subtle text-secondary-emphasis";
                                        <tr>
                                            <td class="fw-semibold">@story.StoryId - @story.Title</td>
                                            <td><span class="badge @statusClass">@story.Status</span></td>
                                            <td>@story.EpicId</td>
                                            <td>@story.Track</td>
                                            <td>@story.TasksDone/@story.TasksTotal</td>
                                            <td class="text-end">
                                                <a asp-controller="AdminWiki"
                                                   asp-action="Index"
                                                   asp-route-doc="@story.WikiRelativePath"
                                                   class="btn btn-sm btn-outline-secondary">
                                                    Abrir
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="h6 fw-semibold mb-0">Revisao mensal de estrategia</h2>
                        <div class="small text-muted">Task ST-051.5</div>
                    </div>
                    @if (Model.MonthlyReviewSnapshot != null)
                    {
                        <span class="text-muted small">
                            Ciclo: @Model.MonthlyReviewSnapshot.MonthStartUtc.ToLocalTime().ToString("MM/yyyy")
                        </span>
                    }
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(Model.MonthlyReviewErrorMessage))
                    {
                        <div class="alert alert-warning mb-0">@Model.MonthlyReviewErrorMessage</div>
                    }
                    else if (Model.MonthlyReviewSnapshot == null)
                    {
                        <div class="alert alert-light mb-0">Revisao mensal indisponivel no momento.</div>
                    }
                    else
                    {
                        <div class="row g-3">
                            <div class="col-12 col-xl-4">
                                <div class="border rounded p-3 h-100">
                                    <h3 class="h6 fw-semibold mb-2">Agenda mensal</h3>
                                    <ol class="mb-0 ps-3">
                                        @foreach (var item in Model.MonthlyReviewSnapshot.Agenda.OrderBy(agenda => agenda.Order))
                                        {
                                            <li class="mb-2">
                                                <div class="fw-semibold">@item.Topic</div>
                                                <div class="small text-muted">Owner: @item.OwnerRole</div>
                                                <div class="small">@item.Objective</div>
                                            </li>
                                        }
                                    </ol>
                                </div>
                            </div>
                            <div class="col-12 col-xl-8">
                                <div class="border rounded p-3 h-100">
                                    <h3 class="h6 fw-semibold mb-2">Registrar ata mensal</h3>
                                    @if (!string.IsNullOrWhiteSpace(Model.MonthlyReviewFeedbackMessage))
                                    {
                                        <div class="alert @(Model.MonthlyReviewFeedbackSuccess ? "alert-success" : "alert-danger")">
                                            @Model.MonthlyReviewFeedbackMessage
                                        </div>
                                    }
                                    <form method="post" asp-action="RecordMonthlyReview" class="row g-2">
                                        <input type="hidden" name="fromUtc" value="@fromValue" />
                                        <input type="hidden" name="toUtc" value="@toValue" />
                                        <input type="hidden" name="category" value="@categoryValue" />
                                        <input type="hidden" name="city" value="@cityValue" />
                                        <input type="hidden" name="proposalSlaMinutes" value="@filters.ProposalSlaMinutes" />
                                        <input type="hidden" name="acceptanceSlaHours" value="@filters.AcceptanceSlaHours" />
                                        <input type="hidden" name="northStarResolutionHours" value="@filters.NorthStarResolutionHours" />
                                        <input type="hidden" name="referenceMonthUtc" value="@Model.MonthlyReviewSnapshot.MonthStartUtc.ToString("yyyy-MM-dd")" />

                                        <div class="col-12">
                                            <label class="form-label form-label-sm text-muted">Resumo executivo</label>
                                            <textarea name="executiveSummary" rows="2" class="form-control" placeholder="Leitura executiva do ciclo mensal"></textarea>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label form-label-sm text-muted">Decisoes estrategicas</label>
                                            <textarea name="strategicDecisions" rows="2" class="form-control" placeholder="Decisoes aprovadas para o proximo ciclo"></textarea>
                                        </div>
                                        <div class="col-12 col-md-6">
                                            <label class="form-label form-label-sm text-muted">Riscos e bloqueios</label>
                                            <textarea name="risksAndBlockers" rows="2" class="form-control" placeholder="Riscos, dependencias e bloqueios"></textarea>
                                        </div>
                                        <div class="col-12 col-md-6">
                                            <label class="form-label form-label-sm text-muted">Bets do proximo mes</label>
                                            <textarea name="nextMonthBets" rows="2" class="form-control" placeholder="Apostas com owner + KPI de sucesso"></textarea>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label form-label-sm text-muted">Notas de budget e capacidade</label>
                                            <textarea name="budgetNotes" rows="2" class="form-control" placeholder="Restricoes/ajustes de budget e capacidade"></textarea>
                                        </div>
                                        <div class="col-12">
                                            <button type="submit" class="btn btn-outline-primary">
                                                <i class="fas fa-calendar-check me-1"></i> Registrar revisao mensal
                                            </button>
                                        </div>
                                    </form>

                                    @if (Model.MonthlyReviewSnapshot.RecentRecords.Count > 0)
                                    {
                                        <hr />
                                        <h4 class="h6 fw-semibold mb-2">Historico recente</h4>
                                        <div class="table-responsive">
                                            <table class="table table-sm mb-0">
                                                <thead>
                                                <tr>
                                                    <th>Mes</th>
                                                    <th>Data registro</th>
                                                    <th>Owner</th>
                                                    <th>Resumo</th>
                                                </tr>
                                                </thead>
                                                <tbody>
                                                @foreach (var record in Model.MonthlyReviewSnapshot.RecentRecords.Take(6))
                                                {
                                                    <tr>
                                                        <td>@record.MonthStartUtc.ToLocalTime().ToString("MM/yyyy")</td>
                                                        <td>@record.CreatedAtUtc.ToLocalTime().ToString("dd/MM HH:mm")</td>
                                                        <td>@record.ActorEmail</td>
                                                        <td>@record.ExecutiveSummary</td>
                                                    </tr>
                                                }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
