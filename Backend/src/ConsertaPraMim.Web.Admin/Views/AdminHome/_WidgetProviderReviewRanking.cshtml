@using System.Globalization
@model ConsertaPraMim.Web.Admin.Models.AdminDashboardViewModel
@{
    var widgetEndpoint = Url.Action("DashboardWidgetSnapshot", "AdminHome", new { widgetKey = "provider-review-ranking" }) ?? "/AdminHome/Widgets/provider-review-ranking";
    var currencyCulture = CultureInfo.GetCultureInfo("pt-BR");
    var rows = Model.Dashboard?.ProviderReviewRanking ?? Array.Empty<ConsertaPraMim.Application.DTOs.AdminReviewRankingItemDto>();
}
<div class="col-12 col-xl-4" data-dashboard-widget data-widget-key="provider-review-ranking" data-widget-endpoint="@widgetEndpoint">
    <div class="widget-card card h-100 dashboard-widget-shell">
        <div class="kpi-card-spinner d-none" data-widget-spinner><span class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span></div>
        <div class="dashboard-widget-skeleton d-none" data-widget-skeleton>
            <div class="dashboard-widget-skeleton-line title"></div>
            <div class="dashboard-widget-skeleton-line subtitle"></div>
            <div class="dashboard-widget-skeleton-line row"></div>
            <div class="dashboard-widget-skeleton-line row"></div>
            <div class="dashboard-widget-skeleton-line row"></div>
        </div>
        <div data-widget-content>
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h2 class="h6 fw-semibold mb-0">Ranking de Prestadores</h2>
                <span class="text-muted small" data-widget-subtitle>Media e volume</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0 event-table">
                    <thead>
                    <tr>
                        <th>Prestador</th>
                        <th class="text-end">Media</th>
                        <th class="text-end">Reviews</th>
                    </tr>
                    </thead>
                    <tbody id="provider-review-ranking-body">
                    @if (rows.Any())
                    {
                        @foreach (var item in rows)
                        {
                            <tr>
                                <td class="fw-semibold">@item.UserName</td>
                                <td class="text-end">@item.AverageRating.ToString("N2", currencyCulture)</td>
                                <td class="text-end">@item.TotalReviews</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="3" class="text-center text-muted py-3">Sem ranking de prestadores para o periodo.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="alert alert-warning py-2 px-3 small d-none m-3" data-widget-error></div>
    </div>
</div>
