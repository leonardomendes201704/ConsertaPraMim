@model ConsertaPraMim.Web.Admin.Models.AdminDashboardViewModel
@{
    var widgetEndpoint = Url.Action("DashboardWidgetSnapshot", "AdminHome", new { widgetKey = "request-category" }) ?? "/AdminHome/Widgets/request-category";
}
<div class="col-12 col-lg-3" data-dashboard-widget data-widget-key="request-category" data-widget-endpoint="@widgetEndpoint">
    <div class="widget-card card h-100 dashboard-widget-shell">
        <div class="kpi-card-spinner d-none" data-widget-spinner><span class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span></div>
        <div class="dashboard-widget-skeleton d-none" data-widget-skeleton"><div class="dashboard-widget-skeleton-line title"></div><div class="dashboard-widget-skeleton-line subtitle"></div><div class="dashboard-widget-skeleton-line row"></div><div class="dashboard-widget-skeleton-line row"></div></div>
        <div data-widget-content>
            <div class="card-header bg-white d-flex justify-content-between align-items-center"><h2 class="h6 fw-semibold mb-0">Pedidos por Categoria</h2><span class="text-muted small">Maior para menor</span></div>
            <div class="card-body">
                <ul class="list-unstyled request-status-list mb-0" id="request-category-list">
                    @if (Model.Dashboard?.RequestsByCategory?.Any() == true)
                    {
                        @foreach (var category in Model.Dashboard.RequestsByCategory)
                        {
                            <li class="d-flex justify-content-between align-items-center"><span class="text-muted">@category.Category</span><span class="badge bg-primary">@category.Count</span></li>
                        }
                    }
                    else
                    {
                        <li class="text-muted">Sem dados de categoria para o filtro selecionado.</li>
                    }
                </ul>
            </div>
        </div>
        <div class="alert alert-warning py-2 px-3 small d-none m-3" data-widget-error></div>
    </div>
</div>
