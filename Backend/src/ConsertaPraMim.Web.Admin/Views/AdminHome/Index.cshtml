                <table class="table table-hover mb-0 event-table">
                    <thead>
                        <tr>
                            <th>Risco</th>
                            <th>Score</th>
                            <th>Janela</th>
                            <th>Categoria</th>
                            <th>Cidade</th>
                            <th>Prestador</th>
                            <th>Cliente</th>
