@using ConsertaPraMim.Application.DTOs
@model ConsertaPraMim.Web.Admin.Models.AdminDashboardViewModel
@{
    var widgetEndpoint = Url.Action("DashboardWidgetSnapshot", "AdminHome", new { widgetKey = "recent-events" }) ?? "/AdminHome/Widgets/recent-events";
    var dashboard = Model.Dashboard;
}
<div class="col-12" data-dashboard-widget data-widget-key="recent-events" data-widget-endpoint="@widgetEndpoint">
    <div class="widget-card card h-100 dashboard-widget-shell">
        <div class="kpi-card-spinner d-none" data-widget-spinner><span class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span></div>
        <div class="dashboard-widget-skeleton d-none" data-widget-skeleton>
            <div class="dashboard-widget-skeleton-line title"></div>
            <div class="dashboard-widget-skeleton-line subtitle"></div>
            <div class="dashboard-widget-skeleton-line row"></div>
            <div class="dashboard-widget-skeleton-line row"></div>
            <div class="dashboard-widget-skeleton-line row"></div>
            <div class="dashboard-widget-skeleton-line row"></div>
        </div>
        <div data-widget-content>
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <div class="recent-events-toolbar w-100">
                    <div class="d-flex flex-column gap-1">
                        <h2 class="h6 fw-semibold mb-0">Eventos Recentes</h2>
                        <span class="text-muted small" id="range-label">
                            @if (dashboard != null)
                            {
                                <text>@dashboard.FromUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ate @dashboard.ToUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</text>
                            }
                        </span>
                        <span class="recent-events-summary" id="recent-events-active-filters">Sem filtros locais aplicados.</span>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button"
                                class="btn btn-outline-primary btn-sm"
                                data-bs-toggle="offcanvas"
                                data-bs-target="#recentEventsFiltersDrawer"
                                aria-controls="recentEventsFiltersDrawer">
                            <i class="fas fa-filter me-1"></i> Filtros
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="recent-events-clear-filters-btn">
                            <i class="fas fa-eraser me-1"></i> Limpar
                        </button>
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0 event-table">
                    <thead>
                    <tr>
                        <th scope="col">
                            <button type="button" class="event-sort-btn" data-sort-column="type">
                                <span>Tipo</span>
                                <i class="fas fa-sort event-sort-icon"></i>
                            </button>
                        </th>
                        <th scope="col">
                            <button type="button" class="event-sort-btn" data-sort-column="title">
                                <span>Titulo</span>
                                <i class="fas fa-sort event-sort-icon"></i>
                            </button>
                        </th>
                        <th scope="col">
                            <button type="button" class="event-sort-btn" data-sort-column="description">
                                <span>Descrição</span>
                                <i class="fas fa-sort event-sort-icon"></i>
                            </button>
                        </th>
                        <th scope="col">
                            <button type="button" class="event-sort-btn is-active" data-sort-column="createdAt" data-sort-direction="desc">
                                <span>Data</span>
                                <i class="fas fa-sort-down event-sort-icon"></i>
                            </button>
                        </th>
                    </tr>
                    </thead>
                    <tbody id="recent-events-body">
                    @if (dashboard?.RecentEvents?.Any() == true)
                    {
                        @foreach (var eventItem in dashboard.RecentEvents)
                        {
                            <tr>
                                <td><span class="badge bg-dark">@eventItem.Type</span></td>
                                <td class="fw-semibold">@eventItem.Title</td>
                                <td class="text-muted">@eventItem.Description</td>
                                <td class="text-muted">@eventItem.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="events-empty-row">
                            <td colspan="4" class="text-center text-muted py-4">Nenhum evento encontrado para os filtros selecionados.</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="alert alert-warning py-2 px-3 small d-none m-3" data-widget-error></div>
    </div>
</div>
