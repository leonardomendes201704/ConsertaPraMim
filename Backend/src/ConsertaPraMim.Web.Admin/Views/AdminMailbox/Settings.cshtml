@model ConsertaPraMim.Web.Admin.Models.AdminMailboxSettingsPageViewModel
@{
    ViewData["Title"] = "Configuração Webmail";
}

<style>
    .mail-settings-card {
        border: 0;
        border-radius: 16px;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
    }

    .mail-settings-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
    }

    @@media (min-width: 992px) {
        .mail-settings-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h3 class="mb-1">Configuração Webmail</h3>
        <p class="text-muted mb-0">Credenciais SMTP/POP3 para envio e sincronização de emails.</p>
    </div>
    <a asp-action="Index" asp-controller="AdminMailbox" class="btn btn-outline-primary">
        <i class="fas fa-envelope me-1"></i>Voltar ao Webmail
    </a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="card mail-settings-card">
    <div class="card-body">
        <div class="small text-muted mb-3">
            Status:
            <span class="badge @(Model.Settings.IsConfigured ? "bg-success" : "bg-secondary")">
                @(Model.Settings.IsConfigured ? "Configurado" : "Nao configurado")
            </span>
            @if (Model.Settings.LastSyncAtUtc.HasValue)
            {
                <span class="ms-2">Ultimo sync: @Model.Settings.LastSyncAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Settings.LastSyncError))
        {
            <div class="alert alert-warning py-2">
                <strong>Ultimo erro de sync:</strong> @Model.Settings.LastSyncError
            </div>
        }

        <form asp-action="SaveSettings" asp-controller="AdminMailbox" method="post" class="d-grid gap-3">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="settingsEnabled" name="Enabled" value="true" @(Model.Settings.Enabled ? "checked" : string.Empty) />
                <label class="form-check-label" for="settingsEnabled">Webmail habilitado</label>
            </div>

            <div class="mail-settings-grid">
                <div>
                    <label class="form-label">Nome do remetente</label>
                    <input class="form-control" type="text" name="SenderDisplayName" value="@Model.Settings.SenderDisplayName" required />
                </div>
                <div>
                    <label class="form-label">Email remetente</label>
                    <input class="form-control" type="email" name="SenderEmail" value="@Model.Settings.SenderEmail" required />
                </div>
                <div>
                    <label class="form-label">Usuario (Gmail)</label>
                    <input class="form-control" type="text" name="Username" value="@Model.Settings.Username" required />
                </div>
                <div>
                    <label class="form-label">Senha/App Password</label>
                    <input class="form-control" type="password" name="Password" placeholder="@(Model.Settings.HasPassword ? "Deixe em branco para manter atual" : "Informe a senha")" />
                </div>
                <div>
                    <label class="form-label">SMTP Host</label>
                    <input class="form-control" type="text" name="SmtpHost" value="@Model.Settings.SmtpHost" required />
                </div>
                <div>
                    <label class="form-label">SMTP Porta</label>
                    <input class="form-control" type="number" name="SmtpPort" value="@Model.Settings.SmtpPort" min="1" max="65535" required />
                </div>
                <div>
                    <label class="form-label">POP3 Host</label>
                    <input class="form-control" type="text" name="Pop3Host" value="@Model.Settings.Pop3Host" required />
                </div>
                <div>
                    <label class="form-label">POP3 Porta</label>
                    <input class="form-control" type="number" name="Pop3Port" value="@Model.Settings.Pop3Port" min="1" max="65535" required />
                </div>
                <div>
                    <label class="form-label">Janela de sync (emails)</label>
                    <input class="form-control" type="number" name="SyncWindowSize" value="@Model.Settings.SyncWindowSize" min="1" max="200" required />
                </div>
                <div>
                    <label class="form-label">Intervalo de polling (seg)</label>
                    <input class="form-control" type="number" name="PollIntervalSeconds" value="@Model.Settings.PollIntervalSeconds" min="30" max="3600" required />
                </div>
            </div>

            <div class="d-flex gap-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="smtpSsl" name="SmtpUseSsl" value="true" @(Model.Settings.SmtpUseSsl ? "checked" : string.Empty) />
                    <label class="form-check-label" for="smtpSsl">SMTP SSL/TLS</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="pop3Ssl" name="Pop3UseSsl" value="true" @(Model.Settings.Pop3UseSsl ? "checked" : string.Empty) />
                    <label class="form-check-label" for="pop3Ssl">POP3 SSL/TLS</label>
                </div>
            </div>

            <button type="submit" class="btn btn-success">
                <i class="fas fa-floppy-disk me-1"></i>Salvar configuração
            </button>
        </form>
    </div>
</div>
