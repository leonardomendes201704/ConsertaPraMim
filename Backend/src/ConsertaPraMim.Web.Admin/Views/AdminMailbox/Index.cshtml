@model ConsertaPraMim.Web.Admin.Models.AdminMailboxIndexViewModel
@{
    ViewData["Title"] = "Webmail";
    var inboxActive = Model.Filters.Folder.Equals("inbox", StringComparison.OrdinalIgnoreCase);
    var sentActive = Model.Filters.Folder.Equals("sent", StringComparison.OrdinalIgnoreCase);
}

<style>
    .webmail-card {
        border: 0;
        border-radius: 14px;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
    }

    .webmail-message-item {
        border: 0;
        border-bottom: 1px solid #eef2f7;
    }

    .webmail-message-item:last-child {
        border-bottom: 0;
    }

    .webmail-message-item.active {
        background: #eff6ff;
    }

    .webmail-message-item-unread {
        background: #f8fafc;
    }

    .webmail-pre {
        white-space: pre-wrap;
        font-family: Consolas, "Courier New", monospace;
        font-size: .9rem;
        line-height: 1.45;
    }

    .webmail-settings-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
    }

    @@media (min-width: 992px) {
        .webmail-settings-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h3 class="mb-1">Webmail Admin</h3>
        <p class="text-muted mb-0">Envio e leitura de emails via SMTP/POP3 para clientes e prestadores.</p>
    </div>
    <form asp-action="Sync"
          asp-controller="AdminMailbox"
          method="post"
          class="d-flex gap-2">
        <input type="hidden" name="folder" value="@Model.Filters.Folder" />
        <input type="hidden" name="search" value="@Model.Filters.Search" />
        <input type="hidden" name="page" value="@Model.Filters.Page" />
        <input type="hidden" name="pageSize" value="@Model.Filters.PageSize" />
        <input type="hidden" name="selectedMessageId" value="@Model.Filters.SelectedMessageId" />
        <button type="submit" class="btn btn-outline-primary">
            <i class="fas fa-rotate-right me-1"></i>Sincronizar inbox
        </button>
    </form>
</div>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="row g-3 mb-3">
    <div class="col-12 col-xl-8">
        <div class="card webmail-card h-100">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <ul class="nav nav-pills gap-2">
                        <li class="nav-item">
                            <a class="nav-link @(inboxActive ? "active" : string.Empty)"
                               asp-action="Index"
                               asp-route-folder="inbox"
                               asp-route-search="@Model.Filters.Search"
                               asp-route-pageSize="@Model.Filters.PageSize">
                                Inbox
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(sentActive ? "active" : string.Empty)"
                               asp-action="Index"
                               asp-route-folder="sent"
                               asp-route-search="@Model.Filters.Search"
                               asp-route-pageSize="@Model.Filters.PageSize">
                                Enviados
                            </a>
                        </li>
                    </ul>
                    <form asp-action="Index" asp-controller="AdminMailbox" method="get" class="d-flex gap-2">
                        <input type="hidden" name="folder" value="@Model.Filters.Folder" />
                        <input type="hidden" name="pageSize" value="@Model.Filters.PageSize" />
                        <input type="search"
                               class="form-control"
                               name="search"
                               value="@Model.Filters.Search"
                               placeholder="Buscar por assunto, email, preview..." />
                        <button type="submit" class="btn btn-outline-secondary">
                            <i class="fas fa-magnifying-glass"></i>
                        </button>
                    </form>
                </div>

                @if (Model.Messages.Items.Count == 0)
                {
                    <div class="alert alert-light border text-muted mb-0">
                        Nenhum email encontrado para o filtro atual.
                    </div>
                }
                else
                {
                    <div class="list-group mb-3">
                        @foreach (var item in Model.Messages.Items)
                        {
                            var isSelected = string.Equals(item.Id, Model.Filters.SelectedMessageId, StringComparison.OrdinalIgnoreCase);
                            <a class="list-group-item list-group-item-action webmail-message-item @(isSelected ? "active" : string.Empty) @(!item.IsRead ? "webmail-message-item-unread" : string.Empty)"
                               asp-action="Index"
                               asp-route-folder="@Model.Filters.Folder"
                               asp-route-search="@Model.Filters.Search"
                               asp-route-page="@Model.Filters.Page"
                               asp-route-pageSize="@Model.Filters.PageSize"
                               asp-route-selectedMessageId="@item.Id">
                                <div class="d-flex justify-content-between align-items-start gap-3">
                                    <div class="w-100">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge @(item.Direction.Equals("outbound", StringComparison.OrdinalIgnoreCase) ? "bg-primary" : "bg-secondary")">@item.Direction</span>
                                            @if (!item.IsRead)
                                            {
                                                <span class="badge text-bg-warning">Nao lida</span>
                                            }
                                        </div>
                                        <div class="fw-semibold mt-2">@item.Subject</div>
                                        <div class="small text-muted">@item.FromAddress -> @item.ToAddress</div>
                                        <div class="small text-muted mt-1">@item.Preview</div>
                                    </div>
                                    <div class="small text-muted text-nowrap">
                                        @item.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </div>
                            </a>
                        }
                    </div>

                    @if (Model.Messages.TotalPages > 1)
                    {
                        <nav aria-label="Paginacao de mensagens">
                            <ul class="pagination pagination-sm mb-0">
                                @{
                                    var previousPage = Math.Max(1, Model.Messages.Page - 1);
                                    var nextPage = Math.Min(Model.Messages.TotalPages, Model.Messages.Page + 1);
                                }
                                <li class="page-item @(Model.Messages.Page <= 1 ? "disabled" : string.Empty)">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-folder="@Model.Filters.Folder"
                                       asp-route-search="@Model.Filters.Search"
                                       asp-route-page="@previousPage"
                                       asp-route-pageSize="@Model.Filters.PageSize"
                                       asp-route-selectedMessageId="@Model.Filters.SelectedMessageId">Anterior</a>
                                </li>
                                <li class="page-item disabled">
                                    <span class="page-link">@Model.Messages.Page / @Model.Messages.TotalPages</span>
                                </li>
                                <li class="page-item @(Model.Messages.Page >= Model.Messages.TotalPages ? "disabled" : string.Empty)">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-folder="@Model.Filters.Folder"
                                       asp-route-search="@Model.Filters.Search"
                                       asp-route-page="@nextPage"
                                       asp-route-pageSize="@Model.Filters.PageSize"
                                       asp-route-selectedMessageId="@Model.Filters.SelectedMessageId">Proxima</a>
                                </li>
                            </ul>
                        </nav>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-4">
        <div class="card webmail-card h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0">Detalhes da mensagem</h5>
            </div>
            <div class="card-body">
                @if (Model.SelectedMessage == null)
                {
                    <div class="text-muted">Selecione um email para visualizar o conteudo.</div>
                }
                else
                {
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <span class="badge @(Model.SelectedMessage.Direction.Equals("outbound", StringComparison.OrdinalIgnoreCase) ? "bg-primary" : "bg-secondary")">@Model.SelectedMessage.Direction</span>
                        <span class="small text-muted">@Model.SelectedMessage.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                    </div>
                    <h6>@Model.SelectedMessage.Subject</h6>
                    <div class="small text-muted mb-1"><strong>De:</strong> @Model.SelectedMessage.FromAddress</div>
                    <div class="small text-muted mb-3"><strong>Para:</strong> @Model.SelectedMessage.ToAddress</div>

                    <div class="webmail-pre border rounded p-2 bg-light mb-3">@Model.SelectedMessage.BodyText</div>

                    <form asp-action="MarkRead" asp-controller="AdminMailbox" method="post">
                        <input type="hidden" name="MessageId" value="@Model.SelectedMessage.Id" />
                        <input type="hidden" name="IsRead" value="@(!Model.SelectedMessage.IsRead)" />
                        <input type="hidden" name="Folder" value="@Model.Filters.Folder" />
                        <input type="hidden" name="Search" value="@Model.Filters.Search" />
                        <input type="hidden" name="Page" value="@Model.Filters.Page" />
                        <input type="hidden" name="PageSize" value="@Model.Filters.PageSize" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm">
                            @(Model.SelectedMessage.IsRead ? "Marcar como nao lida" : "Marcar como lida")
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-xl-6">
        <div class="card webmail-card h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0">Enviar email</h5>
            </div>
            <div class="card-body">
                <form asp-action="Send" asp-controller="AdminMailbox" method="post" class="d-grid gap-3">
                    <div>
                        <label class="form-label">Para</label>
                        <input type="email"
                               name="To"
                               class="form-control"
                               list="adminMailboxRecipients"
                               required
                               placeholder="destinatario@exemplo.com" />
                        <datalist id="adminMailboxRecipients">
                            @foreach (var recipient in Model.Recipients)
                            {
                                <option value="@recipient.Email">@recipient.Name (@recipient.Role)</option>
                            }
                        </datalist>
                    </div>
                    <div>
                        <label class="form-label">Assunto</label>
                        <input type="text" name="Subject" class="form-control" required maxlength="200" />
                    </div>
                    <div>
                        <label class="form-label">Mensagem</label>
                        <textarea name="Body" class="form-control" rows="8" required></textarea>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="composeIsHtml" name="IsHtml" value="true" />
                        <label class="form-check-label" for="composeIsHtml">Enviar como HTML</label>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-paper-plane me-1"></i>Enviar email
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-6">
        <div class="card webmail-card h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0">Configuracao SMTP/POP3</h5>
            </div>
            <div class="card-body">
                <div class="small text-muted mb-3">
                    Status:
                    <span class="badge @(Model.Settings.IsConfigured ? "bg-success" : "bg-secondary")">
                        @(Model.Settings.IsConfigured ? "Configurado" : "Nao configurado")
                    </span>
                    @if (Model.Settings.LastSyncAtUtc.HasValue)
                    {
                        <span class="ms-2">Ultimo sync: @Model.Settings.LastSyncAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Settings.LastSyncError))
                {
                    <div class="alert alert-warning py-2">
                        <strong>Ultimo erro de sync:</strong> @Model.Settings.LastSyncError
                    </div>
                }

                <form asp-action="SaveSettings" asp-controller="AdminMailbox" method="post" class="d-grid gap-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="settingsEnabled" name="Enabled" value="true" @(Model.Settings.Enabled ? "checked" : string.Empty) />
                        <label class="form-check-label" for="settingsEnabled">Webmail habilitado</label>
                    </div>

                    <div class="webmail-settings-grid">
                        <div>
                            <label class="form-label">Nome do remetente</label>
                            <input class="form-control" type="text" name="SenderDisplayName" value="@Model.Settings.SenderDisplayName" required />
                        </div>
                        <div>
                            <label class="form-label">Email remetente</label>
                            <input class="form-control" type="email" name="SenderEmail" value="@Model.Settings.SenderEmail" required />
                        </div>
                        <div>
                            <label class="form-label">Usuario (Gmail)</label>
                            <input class="form-control" type="text" name="Username" value="@Model.Settings.Username" required />
                        </div>
                        <div>
                            <label class="form-label">Senha/App Password</label>
                            <input class="form-control" type="password" name="Password" placeholder="@(Model.Settings.HasPassword ? "Deixe em branco para manter atual" : "Informe a senha")" />
                        </div>
                        <div>
                            <label class="form-label">SMTP Host</label>
                            <input class="form-control" type="text" name="SmtpHost" value="@Model.Settings.SmtpHost" required />
                        </div>
                        <div>
                            <label class="form-label">SMTP Porta</label>
                            <input class="form-control" type="number" name="SmtpPort" value="@Model.Settings.SmtpPort" min="1" max="65535" required />
                        </div>
                        <div>
                            <label class="form-label">POP3 Host</label>
                            <input class="form-control" type="text" name="Pop3Host" value="@Model.Settings.Pop3Host" required />
                        </div>
                        <div>
                            <label class="form-label">POP3 Porta</label>
                            <input class="form-control" type="number" name="Pop3Port" value="@Model.Settings.Pop3Port" min="1" max="65535" required />
                        </div>
                        <div>
                            <label class="form-label">Janela de sync (emails)</label>
                            <input class="form-control" type="number" name="SyncWindowSize" value="@Model.Settings.SyncWindowSize" min="1" max="200" required />
                        </div>
                        <div>
                            <label class="form-label">Intervalo de polling (seg)</label>
                            <input class="form-control" type="number" name="PollIntervalSeconds" value="@Model.Settings.PollIntervalSeconds" min="30" max="3600" required />
                        </div>
                    </div>

                    <div class="d-flex gap-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="smtpSsl" name="SmtpUseSsl" value="true" @(Model.Settings.SmtpUseSsl ? "checked" : string.Empty) />
                            <label class="form-check-label" for="smtpSsl">SMTP SSL/TLS</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="pop3Ssl" name="Pop3UseSsl" value="true" @(Model.Settings.Pop3UseSsl ? "checked" : string.Empty) />
                            <label class="form-check-label" for="pop3Ssl">POP3 SSL/TLS</label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-floppy-disk me-1"></i>Salvar configuracao
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
