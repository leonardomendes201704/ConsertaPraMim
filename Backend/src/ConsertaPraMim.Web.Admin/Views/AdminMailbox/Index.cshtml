@model ConsertaPraMim.Web.Admin.Models.AdminMailboxIndexViewModel
@{
    ViewData["Title"] = "Webmail";
    var inboxActive = Model.Filters.Folder.Equals("inbox", StringComparison.OrdinalIgnoreCase);
    var sentActive = Model.Filters.Folder.Equals("sent", StringComparison.OrdinalIgnoreCase);
    var clientRecipients = Model.Recipients
        .Where(x => x.Role.Equals("client", StringComparison.OrdinalIgnoreCase))
        .OrderBy(x => x.Name)
        .ToList();
    var providerRecipients = Model.Recipients
        .Where(x => x.Role.Equals("provider", StringComparison.OrdinalIgnoreCase))
        .OrderBy(x => x.Name)
        .ToList();

    string FormatAttachmentSize(long sizeBytes)
    {
        if (sizeBytes >= 1024L * 1024L)
        {
            return $"{sizeBytes / 1024d / 1024d:0.##} MB";
        }

        if (sizeBytes >= 1024L)
        {
            return $"{sizeBytes / 1024d:0.##} KB";
        }

        return $"{sizeBytes} B";
    }
}

<style>
    .mail-shell {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 16px;
    }

    .mail-card {
        border: 0;
        border-radius: 16px;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
        background: #fff;
    }

    .mail-sidebar {
        padding: 14px;
    }

    .mail-compose-btn {
        border-radius: 999px;
        font-weight: 600;
        width: 100%;
        margin-bottom: 12px;
    }

    .mail-folder-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        text-decoration: none;
        color: #334155;
        border-radius: 12px;
        padding: 10px 12px;
        font-weight: 600;
    }

    .mail-folder-link:hover,
    .mail-folder-link.active {
        color: #1d4ed8;
        background: #eff6ff;
    }

    .mail-folder-link .mail-folder-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .mail-sidebar-section {
        border-top: 1px solid #e2e8f0;
        margin-top: 12px;
        padding-top: 12px;
    }

    .mail-sidebar-muted {
        color: #64748b;
        font-size: .85rem;
    }

    .mail-main {
        min-width: 0;
        display: grid;
        grid-template-rows: minmax(260px, 45vh) minmax(240px, 1fr);
        gap: 16px;
    }

    .mail-panel {
        padding: 14px;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    .mail-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 12px;
        flex-wrap: wrap;
    }

    .mail-search-form {
        display: flex;
        gap: 8px;
        flex: 1;
        min-width: 260px;
    }

    .mail-search-form .form-control {
        border-radius: 999px;
    }

    .mail-message-list {
        overflow: auto;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
    }

    .mail-message-item {
        border: 0;
        border-bottom: 1px solid #e2e8f0;
        text-decoration: none;
        color: #0f172a;
        display: block;
        padding: 12px;
    }

    .mail-message-item:last-child {
        border-bottom: 0;
    }

    .mail-message-item:hover {
        background: #f8fafc;
    }

    .mail-message-item.active {
        background: #eff6ff;
    }

    .mail-message-item-unread {
        background: #f8fafc;
    }

    .mail-message-line {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 8px;
        align-items: start;
    }

    .mail-message-from {
        font-size: .82rem;
        color: #64748b;
        margin-top: 4px;
    }

    .mail-reader {
        overflow: auto;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 14px;
        background: #f8fafc;
    }

    .mail-reader-pre {
        white-space: pre-wrap;
        font-family: Consolas, "Courier New", monospace;
        font-size: .9rem;
        line-height: 1.45;
    }

    .mail-compose-form textarea {
        min-height: 160px;
    }

    .mail-attachment-note {
        font-size: .82rem;
        color: #64748b;
    }

    .mail-attachments {
        margin-top: 16px;
        border-top: 1px solid #e2e8f0;
        padding-top: 14px;
    }

    .mail-attachments-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 10px;
    }

    .mail-attachment-item {
        width: 100%;
        text-align: left;
        border: 1px solid #dbeafe;
        background: #eff6ff;
        color: #1e3a8a;
        border-radius: 10px;
        padding: 10px 12px;
    }

    .mail-attachment-item:hover {
        background: #dbeafe;
    }

    .mail-attachment-name {
        display: block;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .mail-attachment-meta {
        display: block;
        font-size: .8rem;
        color: #475569;
    }

    .mail-send-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.55);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 2000;
        backdrop-filter: blur(1px);
    }

    .mail-send-overlay.is-visible {
        display: flex;
    }

    .mail-send-overlay-card {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.25);
        padding: 20px 24px;
        min-width: 220px;
        text-align: center;
    }

    .mail-send-overlay-title {
        margin-top: 10px;
        margin-bottom: 0;
        font-weight: 600;
        color: #0f172a;
    }

    .mail-lightbox {
        position: fixed;
        inset: 0;
        background: rgba(2, 6, 23, 0.9);
        z-index: 2100;
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .mail-lightbox.is-visible {
        display: flex;
    }

    .mail-lightbox-close {
        position: absolute;
        top: 16px;
        right: 18px;
        border: 0;
        background: rgba(255, 255, 255, 0.12);
        color: #fff;
        width: 40px;
        height: 40px;
        border-radius: 999px;
        font-size: 20px;
        line-height: 1;
    }

    .mail-lightbox-image {
        max-width: min(95vw, 1400px);
        max-height: 82vh;
        object-fit: contain;
        border-radius: 10px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        background: #000;
    }

    .mail-lightbox-caption {
        color: #e2e8f0;
        font-size: .92rem;
        margin-top: 10px;
        text-align: center;
        max-width: 90vw;
        word-break: break-word;
    }

    @@media (max-width: 1200px) {
        .mail-shell {
            grid-template-columns: 1fr;
        }

        .mail-main {
            grid-template-rows: minmax(260px, 40vh) minmax(240px, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .mail-search-form {
            min-width: 0;
            width: 100%;
        }
    }
</style>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h3 class="mb-1">Webmail Admin</h3>
        <p class="text-muted mb-0">Inbox e enviados com leitura no mesmo fluxo do painel.</p>
    </div>
    <a asp-action="Settings" asp-controller="AdminMailbox" class="btn btn-outline-secondary">
        <i class="fas fa-gear me-1"></i>Configurações SMTP/POP3
    </a>
</div>

<div class="modal fade" id="composeEmailModal" tabindex="-1" aria-labelledby="composeEmailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form asp-action="Send"
                  asp-controller="AdminMailbox"
                  method="post"
                  enctype="multipart/form-data"
                  id="composeEmailForm"
                  class="mail-compose-form">
                <div class="modal-header">
                    <h5 class="modal-title" id="composeEmailModalLabel">Novo email</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body d-grid gap-3">
                    <div>
                        <label class="form-label">Destinatario</label>
                        <select class="form-select"
                                name="RecipientUserId"
                                size="8"
                                required>
                            <option value="">Selecione um cliente ou prestador</option>
                            @if (clientRecipients.Count > 0)
                            {
                                <optgroup label="Clientes">
                                    @foreach (var recipient in clientRecipients)
                                    {
                                        <option value="@recipient.UserId">@recipient.Name (@recipient.Email)</option>
                                    }
                                </optgroup>
                            }
                            @if (providerRecipients.Count > 0)
                            {
                                <optgroup label="Prestadores">
                                    @foreach (var recipient in providerRecipients)
                                    {
                                        <option value="@recipient.UserId">@recipient.Name (@recipient.Email)</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Assunto</label>
                        <input type="text" name="Subject" class="form-control" required maxlength="200" />
                    </div>
                    <div>
                        <label class="form-label">Mensagem</label>
                        <textarea name="Body" class="form-control" required></textarea>
                    </div>
                    <div>
                        <label class="form-label">Anexos</label>
                        <input type="file" name="Attachments" class="form-control" multiple />
                        <div class="mail-attachment-note mt-1">
                            Maximo: 10 anexos, 10 MB por arquivo, 25 MB no total.
                        </div>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="composeIsHtmlModal" name="IsHtml" value="true" />
                        <label class="form-check-label" for="composeIsHtmlModal">Enviar como HTML</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="composeEmailSubmit">
                        <i class="fas fa-paper-plane me-1"></i>Enviar email
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="mail-send-overlay" id="mailSendOverlay" aria-hidden="true">
    <div class="mail-send-overlay-card">
        <div class="spinner-border text-primary" role="status" aria-hidden="true"></div>
        <p class="mail-send-overlay-title">
            Enviando...
            <i class="fas fa-paper-plane fa-beat ms-1"></i>
        </p>
    </div>
</div>

<div class="mail-lightbox" id="mailImageLightbox" aria-hidden="true">
    <button type="button" class="mail-lightbox-close" id="mailImageLightboxClose" aria-label="Fechar visualizacao">
        <i class="fas fa-xmark"></i>
    </button>
    <img id="mailImageLightboxImage" class="mail-lightbox-image" alt="Anexo de imagem" />
    <div class="mail-lightbox-caption" id="mailImageLightboxCaption"></div>
</div>

<script>
    (() => {
        const composeForm = document.getElementById('composeEmailForm');
        const overlay = document.getElementById('mailSendOverlay');
        const submitButton = document.getElementById('composeEmailSubmit');

        if (!composeForm || !overlay || !submitButton) {
            return;
        }

        composeForm.addEventListener('submit', () => {
            if (!composeForm.checkValidity()) {
                return;
            }

            submitButton.setAttribute('disabled', 'disabled');
            overlay.classList.add('is-visible');
            overlay.setAttribute('aria-hidden', 'false');
        });
    })();

    (() => {
        const lightbox = document.getElementById('mailImageLightbox');
        const lightboxImage = document.getElementById('mailImageLightboxImage');
        const lightboxCaption = document.getElementById('mailImageLightboxCaption');
        const lightboxClose = document.getElementById('mailImageLightboxClose');
        let currentObjectUrl = null;

        const decodeBase64ToBlob = (base64, contentType) => {
            const binaryString = atob(base64);
            const length = binaryString.length;
            const bytes = new Uint8Array(length);
            for (let i = 0; i < length; i++) {
                bytes[i] = binaryString.charCodeAt(i);
            }

            return new Blob([bytes], { type: contentType || 'application/octet-stream' });
        };

        const cleanupLightbox = () => {
            if (currentObjectUrl) {
                URL.revokeObjectURL(currentObjectUrl);
                currentObjectUrl = null;
            }

            lightboxImage.removeAttribute('src');
            lightbox.classList.remove('is-visible');
            lightbox.setAttribute('aria-hidden', 'true');
        };

        const downloadAttachment = (fileName, contentType, contentBase64) => {
            const blob = decodeBase64ToBlob(contentBase64, contentType);
            const objectUrl = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = objectUrl;
            link.download = fileName || 'anexo.bin';
            document.body.appendChild(link);
            link.click();
            link.remove();
            URL.revokeObjectURL(objectUrl);
        };

        document.querySelectorAll('.js-mail-attachment-download').forEach(button => {
            button.addEventListener('click', () => {
                downloadAttachment(
                    button.dataset.fileName,
                    button.dataset.contentType,
                    button.dataset.contentBase64);
            });
        });

        document.querySelectorAll('.js-mail-attachment-image').forEach(button => {
            button.addEventListener('click', () => {
                const blob = decodeBase64ToBlob(button.dataset.contentBase64, button.dataset.contentType);
                currentObjectUrl = URL.createObjectURL(blob);
                lightboxImage.src = currentObjectUrl;
                lightboxCaption.textContent = button.dataset.fileName || 'Imagem';
                lightbox.classList.add('is-visible');
                lightbox.setAttribute('aria-hidden', 'false');
            });
        });

        if (lightboxClose) {
            lightboxClose.addEventListener('click', cleanupLightbox);
        }

        if (lightbox) {
            lightbox.addEventListener('click', (event) => {
                if (event.target === lightbox) {
                    cleanupLightbox();
                }
            });
        }

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && lightbox && lightbox.classList.contains('is-visible')) {
                cleanupLightbox();
            }
        });
    })();
</script>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="mail-shell">
    <aside class="mail-card mail-sidebar">
        <button class="btn btn-primary mail-compose-btn" type="button" data-bs-toggle="modal" data-bs-target="#composeEmailModal">
            <i class="fas fa-pen-to-square me-1"></i>Escrever
        </button>

        <a class="mail-folder-link @(inboxActive ? "active" : string.Empty)"
           asp-action="Index"
           asp-route-folder="inbox"
           asp-route-search="@Model.Filters.Search"
           asp-route-pageSize="@Model.Filters.PageSize">
            <span class="mail-folder-label"><i class="fas fa-inbox"></i>Inbox</span>
        </a>
        <a class="mail-folder-link @(sentActive ? "active" : string.Empty)"
           asp-action="Index"
           asp-route-folder="sent"
           asp-route-search="@Model.Filters.Search"
           asp-route-pageSize="@Model.Filters.PageSize">
            <span class="mail-folder-label"><i class="fas fa-paper-plane"></i>Enviados</span>
        </a>

        <div class="mail-sidebar-section">
            <div class="small fw-semibold mb-1">Sincronização</div>
            <div class="mail-sidebar-muted">
                @if (Model.Messages.LastSyncAtUtc.HasValue)
                {
                    <text>Último sync: @Model.Messages.LastSyncAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</text>
                }
                else
                {
                    <text>Sem sincronização recente.</text>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Messages.LastSyncError))
            {
                <div class="text-danger small mt-2">@Model.Messages.LastSyncError</div>
            }
        </div>

    </aside>

    <section class="mail-main">
        <div class="mail-card mail-panel">
            <div class="mail-toolbar">
                <form asp-action="Index" asp-controller="AdminMailbox" method="get" class="mail-search-form">
                    <input type="hidden" name="folder" value="@Model.Filters.Folder" />
                    <input type="hidden" name="pageSize" value="@Model.Filters.PageSize" />
                    <input type="search"
                           class="form-control"
                           name="search"
                           value="@Model.Filters.Search"
                           placeholder="Buscar por assunto, email, preview..." />
                    <button type="submit" class="btn btn-outline-secondary rounded-pill px-3">
                        <i class="fas fa-magnifying-glass"></i>
                    </button>
                </form>

                <form asp-action="Sync" asp-controller="AdminMailbox" method="post" class="d-flex gap-2">
                    <input type="hidden" name="folder" value="@Model.Filters.Folder" />
                    <input type="hidden" name="search" value="@Model.Filters.Search" />
                    <input type="hidden" name="page" value="@Model.Filters.Page" />
                    <input type="hidden" name="pageSize" value="@Model.Filters.PageSize" />
                    <input type="hidden" name="selectedMessageId" value="@Model.Filters.SelectedMessageId" />
                    <button type="submit" class="btn btn-outline-primary rounded-pill px-3">
                        <i class="fas fa-rotate-right me-1"></i>Sync
                    </button>
                </form>
            </div>

            @if (Model.Messages.Items.Count == 0)
            {
                <div class="alert alert-light border text-muted mb-0">
                    Nenhum email encontrado para o filtro atual.
                </div>
            }
            else
            {
                <div class="mail-message-list">
                    @foreach (var item in Model.Messages.Items)
                    {
                        var isSelected = string.Equals(item.Id, Model.Filters.SelectedMessageId, StringComparison.OrdinalIgnoreCase);
                        <a class="mail-message-item @(isSelected ? "active" : string.Empty) @(!item.IsRead ? "mail-message-item-unread" : string.Empty)"
                           asp-action="Index"
                           asp-route-folder="@Model.Filters.Folder"
                           asp-route-search="@Model.Filters.Search"
                           asp-route-page="@Model.Filters.Page"
                           asp-route-pageSize="@Model.Filters.PageSize"
                           asp-route-selectedMessageId="@item.Id">
                            <div class="mail-message-line">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge @(item.Direction.Equals("outbound", StringComparison.OrdinalIgnoreCase) ? "bg-primary" : "bg-secondary")">@item.Direction</span>
                                        @if (!item.IsRead)
                                        {
                                            <span class="badge text-bg-warning">Nao lida</span>
                                        }
                                    </div>
                                    <div class="fw-semibold mt-1">@item.Subject</div>
                                    <div class="mail-message-from">@item.FromAddress -> @item.ToAddress</div>
                                    <div class="small text-muted mt-1">@item.Preview</div>
                                </div>
                                <div class="small text-muted text-nowrap">@item.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </a>
                    }
                </div>

                @if (Model.Messages.TotalPages > 1)
                {
                    <nav aria-label="Paginacao de mensagens" class="mt-2">
                        <ul class="pagination pagination-sm mb-0">
                            @{
                                var previousPage = Math.Max(1, Model.Messages.Page - 1);
                                var nextPage = Math.Min(Model.Messages.TotalPages, Model.Messages.Page + 1);
                            }
                            <li class="page-item @(Model.Messages.Page <= 1 ? "disabled" : string.Empty)">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-folder="@Model.Filters.Folder"
                                   asp-route-search="@Model.Filters.Search"
                                   asp-route-page="@previousPage"
                                   asp-route-pageSize="@Model.Filters.PageSize"
                                   asp-route-selectedMessageId="@Model.Filters.SelectedMessageId">Anterior</a>
                            </li>
                            <li class="page-item disabled">
                                <span class="page-link">@Model.Messages.Page / @Model.Messages.TotalPages</span>
                            </li>
                            <li class="page-item @(Model.Messages.Page >= Model.Messages.TotalPages ? "disabled" : string.Empty)">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-folder="@Model.Filters.Folder"
                                   asp-route-search="@Model.Filters.Search"
                                   asp-route-page="@nextPage"
                                   asp-route-pageSize="@Model.Filters.PageSize"
                                   asp-route-selectedMessageId="@Model.Filters.SelectedMessageId">Próxima</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>

        <div class="mail-card mail-panel">
            <h6 class="mb-3">Leitura</h6>
            @if (Model.SelectedMessage == null)
            {
                <div class="mail-reader d-flex align-items-center justify-content-center text-muted">
                    Selecione uma mensagem para visualizar o conteúdo completo.
                </div>
            }
            else
            {
                <div class="mail-reader">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @(Model.SelectedMessage.Direction.Equals("outbound", StringComparison.OrdinalIgnoreCase) ? "bg-primary" : "bg-secondary")">@Model.SelectedMessage.Direction</span>
                            @if (!Model.SelectedMessage.IsRead)
                            {
                                <span class="badge text-bg-warning">Nao lida</span>
                            }
                        </div>
                        <span class="small text-muted">@Model.SelectedMessage.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                    </div>
                    <h5 class="mb-2">@Model.SelectedMessage.Subject</h5>
                    <div class="small text-muted mb-1"><strong>De:</strong> @Model.SelectedMessage.FromAddress</div>
                    <div class="small text-muted mb-3"><strong>Para:</strong> @Model.SelectedMessage.ToAddress</div>

                    <div class="mail-reader-pre">@Model.SelectedMessage.BodyText</div>

                    @if (Model.SelectedMessage.Attachments is { Count: > 0 })
                    {
                        <div class="mail-attachments">
                            <h6 class="mb-2">Anexos (@Model.SelectedMessage.Attachments.Count)</h6>
                            <div class="mail-attachments-grid">
                                @foreach (var attachment in Model.SelectedMessage.Attachments)
                                {
                                    if (attachment.IsImage)
                                    {
                                        <button type="button"
                                                class="mail-attachment-item js-mail-attachment-image"
                                                data-file-name="@attachment.FileName"
                                                data-content-type="@attachment.ContentType"
                                                data-content-base64="@attachment.ContentBase64">
                                            <span class="mail-attachment-name">
                                                <i class="fas fa-image me-1"></i>@attachment.FileName
                                            </span>
                                            <span class="mail-attachment-meta">@FormatAttachmentSize(attachment.SizeBytes) - Abrir imagem</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="mail-attachment-item js-mail-attachment-download"
                                                data-file-name="@attachment.FileName"
                                                data-content-type="@attachment.ContentType"
                                                data-content-base64="@attachment.ContentBase64">
                                            <span class="mail-attachment-name">
                                                <i class="fas fa-paperclip me-1"></i>@attachment.FileName
                                            </span>
                                            <span class="mail-attachment-meta">@FormatAttachmentSize(attachment.SizeBytes) - Download</span>
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>

                <form asp-action="MarkRead" asp-controller="AdminMailbox" method="post" class="mt-2">
                    <input type="hidden" name="MessageId" value="@Model.SelectedMessage.Id" />
                    <input type="hidden" name="IsRead" value="@(!Model.SelectedMessage.IsRead)" />
                    <input type="hidden" name="Folder" value="@Model.Filters.Folder" />
                    <input type="hidden" name="Search" value="@Model.Filters.Search" />
                    <input type="hidden" name="Page" value="@Model.Filters.Page" />
                    <input type="hidden" name="PageSize" value="@Model.Filters.PageSize" />
                    <button type="submit" class="btn btn-outline-secondary btn-sm">
                        @(Model.SelectedMessage.IsRead ? "Marcar como nao lida" : "Marcar como lida")
                    </button>
                </form>
            }
        </div>
    </section>
</div>
