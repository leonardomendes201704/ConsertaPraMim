@model ConsertaPraMim.Web.Admin.Models.AdminRoadmapViewModel
@{
    ViewData["Title"] = "Roadmap";
}

@functions {
    private static string ResolveEpicStatusClass(string status)
    {
        return status.Trim().ToLowerInvariant() switch
        {
            "done" => "bg-success-subtle text-success-emphasis border border-success-subtle",
            "in progress" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
            "backlog" => "bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle",
            _ => "bg-info-subtle text-info-emphasis border border-info-subtle"
        };
    }

    private static string ResolveStoryStatusClass(string status)
    {
        return status.Trim().ToLowerInvariant() switch
        {
            "done" => "border-success-subtle",
            "in progress" => "border-warning-subtle",
            _ => "border-secondary-subtle"
        };
    }
}

@section Styles {
    <style>
        .roadmap-filters,
        .roadmap-panel,
        .roadmap-column {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            box-shadow: 0 10px 24px rgba(15, 23, 42, .06);
        }

        .roadmap-filters-drawer {
            width: min(420px, 92vw);
        }

        .roadmap-summary {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
            gap: 10px;
        }

        .roadmap-summary-card {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 12px;
        }

        .roadmap-summary-label {
            font-size: .76rem;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: #64748b;
            font-weight: 700;
        }

        .roadmap-summary-value {
            font-size: 1.05rem;
            color: #0f172a;
            font-weight: 700;
        }

        .roadmap-epic-card {
            border-radius: 12px;
            border: 1px solid #e5e7eb;
            padding: 12px;
            height: 100%;
        }

        .roadmap-epic-meta {
            font-size: .8rem;
            color: #64748b;
        }

        .roadmap-board {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
        }

        .roadmap-column {
            min-height: 460px;
            padding: 10px;
        }

        .roadmap-column-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            border-bottom: 1px solid #e5e7eb;
            padding: 8px 6px 10px;
            margin-bottom: 10px;
        }

        .roadmap-story-card {
            border-radius: 12px;
            border: 1px solid #e5e7eb;
            padding: 10px;
            background: #fff;
            box-shadow: 0 6px 14px rgba(15, 23, 42, .05);
        }

        .roadmap-story-objective {
            font-size: .88rem;
            color: #475569;
        }

        @@media (max-width: 1200px) {
            .roadmap-board {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h3 class="mb-1">Roadmap de Produto</h3>
        <p class="text-muted mb-0">Backlog estrategico de crescimento com leitura automatica das stories/epics em markdown.</p>
    </div>
    <div class="d-flex align-items-end gap-2 flex-wrap justify-content-end">
        <div class="text-end small text-muted">
            <div><strong>Raiz:</strong> <code>@Model.DocumentationRootPath</code></div>
            <div><strong>Atualizado:</strong> @Model.GeneratedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</div>
        </div>
        <button type="button"
                class="btn btn-outline-dark"
                data-bs-toggle="offcanvas"
                data-bs-target="#roadmapFiltersDrawer"
                aria-controls="roadmapFiltersDrawer">
            <i class="fas fa-sliders-h me-1"></i> Filtros
        </button>
    </div>
</div>

<div class="offcanvas offcanvas-end roadmap-filters-drawer"
     tabindex="-1"
     id="roadmapFiltersDrawer"
     aria-labelledby="roadmapFiltersDrawerLabel">
    <div class="offcanvas-header">
        <h2 class="offcanvas-title fs-5" id="roadmapFiltersDrawerLabel">Filtros do Roadmap</h2>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Fechar"></button>
    </div>
    <div class="offcanvas-body">
        <form method="get" class="row g-3">
            <div class="col-12">
                <label for="roadmapSearch" class="form-label fw-semibold mb-1">Palavra-chave</label>
                <input id="roadmapSearch" name="q" value="@Model.SearchTerm" type="text" class="form-control" placeholder="epic, story, titulo, objetivo..." />
            </div>
            <div class="col-12">
                <label for="roadmapEpic" class="form-label fw-semibold mb-1">Epic</label>
                <select id="roadmapEpic" name="epic" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var option in Model.EpicOptions)
                    {
                        if (string.Equals(Model.EpicFilter, option.Value, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@option.Value" selected>@option.Label</option>
                        }
                        else
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-md-6">
                <label for="roadmapTrack" class="form-label fw-semibold mb-1">Trilha</label>
                <select id="roadmapTrack" name="trilha" class="form-select">
                    <option value="">Todas</option>
                    @foreach (var option in Model.TrackOptions)
                    {
                        if (string.Equals(Model.TrackFilter, option.Value, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@option.Value" selected>@option.Label</option>
                        }
                        else
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-md-6">
                <label for="roadmapStatus" class="form-label fw-semibold mb-1">Status</label>
                <select id="roadmapStatus" name="status" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var option in Model.StatusOptions)
                    {
                        if (string.Equals(Model.StatusFilter, option.Value, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@option.Value" selected>@option.Label</option>
                        }
                        else
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary"><i class="fas fa-filter me-1"></i>Filtrar</button>
                <a asp-controller="AdminRoadmap" asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-eraser me-1"></i>Limpar filtros</a>
            </div>
        </form>
    </div>
</div>

<section class="roadmap-summary mb-3">
    <article class="roadmap-summary-card"><div class="roadmap-summary-label">Epics</div><div class="roadmap-summary-value">@Model.FilteredEpics / @Model.TotalEpics</div></article>
    <article class="roadmap-summary-card"><div class="roadmap-summary-label">Stories</div><div class="roadmap-summary-value">@Model.FilteredStories / @Model.TotalStories</div></article>
    <article class="roadmap-summary-card"><div class="roadmap-summary-label">Backlog</div><div class="roadmap-summary-value">@Model.BacklogStories</div></article>
    <article class="roadmap-summary-card"><div class="roadmap-summary-label">In Progress</div><div class="roadmap-summary-value">@Model.InProgressStories</div></article>
    <article class="roadmap-summary-card"><div class="roadmap-summary-label">Done</div><div class="roadmap-summary-value">@Model.DoneStories</div></article>
</section>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-warning mb-3"><i class="fas fa-triangle-exclamation me-2"></i>@Model.ErrorMessage</div>
}

<section class="roadmap-panel p-3 mb-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h4 class="h6 mb-0">Epics estrategicos</h4>
        <span class="small text-muted">Visao de trilha, status e progresso por stories</span>
    </div>

    @if (Model.Epics.Count == 0)
    {
        <div class="text-muted">Nenhum epic encontrado para os filtros aplicados.</div>
    }
    else
    {
        <div class="row g-2">
            @foreach (var epic in Model.Epics)
            {
                <div class="col-12 col-xl-6">
                    <article class="roadmap-epic-card">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <div class="fw-semibold">@epic.EpicId - @epic.Title</div>
                                <div class="roadmap-epic-meta">@epic.Track</div>
                            </div>
                            <span class="badge rounded-pill @ResolveEpicStatusClass(epic.Status)">@epic.Status</span>
                        </div>
                        <p class="mb-2 text-body-secondary">@epic.Objective</p>
                        <div class="small text-muted mb-2">
                            Stories: @epic.StoriesTotal | Backlog: @epic.StoriesBacklog | In Progress: @epic.StoriesInProgress | Done: @epic.StoriesDone
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-controller="AdminWiki" asp-action="Index" asp-route-doc="@epic.WikiRelativePath" class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-book-open me-1"></i>Ver documento
                            </a>
                            <span class="small text-muted">@epic.LastModifiedUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>

<section class="roadmap-board">
    <div class="roadmap-column">
        <div class="roadmap-column-header">
            <h5 class="h6 mb-0">Backlog</h5>
            <span class="badge text-bg-secondary">@Model.StoriesBacklog.Count</span>
        </div>
        <div class="d-flex flex-column gap-2">
            @if (Model.StoriesBacklog.Count == 0)
            {
                <div class="text-muted small">Sem stories neste status.</div>
            }
            else
            {
                @foreach (var story in Model.StoriesBacklog)
                {
                    <article class="roadmap-story-card @ResolveStoryStatusClass(story.Status)">
                        <div class="fw-semibold">@story.StoryId - @story.Title</div>
                        <div class="small text-muted mb-1">@story.EpicId @(!string.IsNullOrWhiteSpace(story.EpicTitle) ? $"- {story.EpicTitle}" : string.Empty)</div>
                        <p class="roadmap-story-objective mb-2">@story.Objective</p>
                        <div class="d-flex justify-content-between align-items-center small">
                            <span>Tarefas: @story.TasksDone/@story.TasksTotal</span>
                            <a asp-controller="AdminWiki" asp-action="Index" asp-route-doc="@story.WikiRelativePath">Detalhes</a>
                        </div>
                    </article>
                }
            }
        </div>
    </div>

    <div class="roadmap-column">
        <div class="roadmap-column-header">
            <h5 class="h6 mb-0">In Progress</h5>
            <span class="badge text-bg-warning">@Model.StoriesInProgress.Count</span>
        </div>
        <div class="d-flex flex-column gap-2">
            @if (Model.StoriesInProgress.Count == 0)
            {
                <div class="text-muted small">Sem stories neste status.</div>
            }
            else
            {
                @foreach (var story in Model.StoriesInProgress)
                {
                    <article class="roadmap-story-card @ResolveStoryStatusClass(story.Status)">
                        <div class="fw-semibold">@story.StoryId - @story.Title</div>
                        <div class="small text-muted mb-1">@story.EpicId @(!string.IsNullOrWhiteSpace(story.EpicTitle) ? $"- {story.EpicTitle}" : string.Empty)</div>
                        <p class="roadmap-story-objective mb-2">@story.Objective</p>
                        <div class="d-flex justify-content-between align-items-center small">
                            <span>Tarefas: @story.TasksDone/@story.TasksTotal</span>
                            <a asp-controller="AdminWiki" asp-action="Index" asp-route-doc="@story.WikiRelativePath">Detalhes</a>
                        </div>
                    </article>
                }
            }
        </div>
    </div>

    <div class="roadmap-column">
        <div class="roadmap-column-header">
            <h5 class="h6 mb-0">Done</h5>
            <span class="badge text-bg-success">@Model.StoriesDone.Count</span>
        </div>
        <div class="d-flex flex-column gap-2">
            @if (Model.StoriesDone.Count == 0)
            {
                <div class="text-muted small">Sem stories neste status.</div>
            }
            else
            {
                @foreach (var story in Model.StoriesDone)
                {
                    <article class="roadmap-story-card @ResolveStoryStatusClass(story.Status)">
                        <div class="fw-semibold">@story.StoryId - @story.Title</div>
                        <div class="small text-muted mb-1">@story.EpicId @(!string.IsNullOrWhiteSpace(story.EpicTitle) ? $"- {story.EpicTitle}" : string.Empty)</div>
                        <p class="roadmap-story-objective mb-2">@story.Objective</p>
                        <div class="d-flex justify-content-between align-items-center small">
                            <span>Tarefas: @story.TasksDone/@story.TasksTotal</span>
                            <a asp-controller="AdminWiki" asp-action="Index" asp-route-doc="@story.WikiRelativePath">Detalhes</a>
                        </div>
                    </article>
                }
            }
        </div>
    </div>
</section>
