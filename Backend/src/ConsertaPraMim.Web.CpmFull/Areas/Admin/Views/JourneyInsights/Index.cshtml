@model AdminJourneyOperationsDashboardPageViewModel
@{
    ViewData["Title"] = Model.Title;

    static string PercentLabel(int part, int total)
    {
        if (total <= 0)
        {
            return "0%";
        }

        return $"{(part * 100.0 / total):N0}%";
    }

    static string HoursLabel(decimal? hours)
    {
        if (!hours.HasValue || hours.Value <= 0)
        {
            return "-";
        }

        return $"{Math.Round(hours.Value, 1, MidpointRounding.AwayFromZero):N1} h";
    }

    static string StateLabel(string state) => string.IsNullOrWhiteSpace(state) ? "-" : AppMobileCPM.Services.AdminKanbanJourneyStates.GetLabel(state);
    static string SourceLabel(string source) => string.IsNullOrWhiteSpace(source) ? "-" : AppMobileCPM.Services.AdminKanbanJourneySourceChannels.GetLabel(source);
    static string BoardLabel(string board) => board == AppMobileCPM.Services.AdminKanbanBoardTypes.Providers ? "Prestadores" : "Clientes";
}

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
    <div>
        <h1 class="h4 fw-bold mb-1">@Model.Title</h1>
        <p class="text-secondary mb-0">@Model.Subtitle</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" href="@Model.DashboardUrl">Painel admin</a>
        <a class="btn btn-outline-secondary" href="@Model.ClientsBoardUrl">Funil clientes</a>
        <a class="btn btn-outline-secondary" href="@Model.ProvidersBoardUrl">Onboarding prestadores</a>
        <a class="btn btn-outline-secondary" href="@Model.TelegramDashboardUrl">Painel Telegram</a>
        <button type="button" class="btn btn-primary" data-bs-toggle="offcanvas" data-bs-target="#journeyInsightsFiltersDrawer" aria-controls="journeyInsightsFiltersDrawer">
            Filtros
        </button>
    </div>
</div>

<div class="d-flex flex-wrap align-items-center gap-2 small text-secondary mb-4">
    <span>Escopo: <strong>@Model.SelectedBoardLabel</strong></span>
    <span>Canal: <strong>@Model.SelectedSourceLabel</strong></span>
    <span>Periodo: <strong>@Model.PeriodLabel</strong></span>
    <span>Rollout atual: <strong>@Model.Governance.RolloutPercentage%</strong></span>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="small text-uppercase text-secondary fw-semibold mb-1">Jornadas</div>
            <div class="display-6 fw-bold">@Model.Snapshot.TotalJourneys</div>
            <div class="small text-secondary">Agendadas: @Model.Snapshot.ScheduledJourneys | Conectadas: @Model.Snapshot.ProviderConnectedJourneys</div>
        </div></div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="small text-uppercase text-secondary fw-semibold mb-1">Concluidas</div>
            <div class="display-6 fw-bold">@Model.Snapshot.CompletedJourneys</div>
            <div class="small text-secondary">@PercentLabel(Model.Snapshot.CompletedJourneys, Model.Snapshot.TotalJourneys) do recorte fecharam a jornada</div>
        </div></div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="small text-uppercase text-secondary fw-semibold mb-1">Excecoes</div>
            <div class="display-6 fw-bold">@Model.Snapshot.OperationalExceptionJourneys</div>
            <div class="small text-secondary">Sem match: @Model.Snapshot.NoMatchJourneys | Contestacoes: @Model.Snapshot.ContestationJourneys</div>
        </div></div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="small text-uppercase text-secondary fw-semibold mb-1">Flags criticas</div>
            <div class="display-6 fw-bold">@((Model.Governance.Enabled && Model.Governance.IntakeEnabled) ? "ON" : "OFF")</div>
            <div class="small text-secondary">Matching: @(Model.Governance.MatchingEnabled ? "ON" : "OFF") | Dispatch: @(Model.Governance.DispatchEnabled ? "ON" : "OFF")</div>
        </div></div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="small text-uppercase text-secondary fw-semibold mb-1">Falhas de agenda</div>
            <div class="display-6 fw-bold">@Model.Snapshot.ScheduleFailureJourneys</div>
            <div class="small text-secondary">Timers vencidos: @Model.Snapshot.ActiveTimerOverdueJourneys</div>
        </div></div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="small text-uppercase text-secondary fw-semibold mb-1">Falhas de disparo</div>
            <div class="display-6 fw-bold">@Model.Snapshot.DispatchFailureJourneys</div>
            <div class="small text-secondary">Leituras para reavaliar ondas e cobertura</div>
        </div></div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="small text-uppercase text-secondary fw-semibold mb-1">Media ate agenda</div>
            <div class="display-6 fw-bold">@HoursLabel(Model.Snapshot.AverageHoursToSchedule)</div>
            <div class="small text-secondary">Media ate reserva: @HoursLabel(Model.Snapshot.AverageHoursToReserve)</div>
        </div></div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="small text-uppercase text-secondary fw-semibold mb-1">Media ate conclusao</div>
            <div class="display-6 fw-bold">@HoursLabel(Model.Snapshot.AverageHoursToComplete)</div>
            <div class="small text-secondary">Reviews fechadas: @Model.Snapshot.ReviewCompletedJourneys</div>
        </div></div>
    </div>
</div>

@if (!Model.HasData)
{
    <div class="alert alert-info border-0 shadow-sm">
        Nao ha jornadas no periodo filtrado. Ajuste o drawer de filtros para ampliar a leitura.
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-12 col-xxl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5 mb-1">Governanca e rollout</h2>
                    <p class="text-secondary small mb-3">Leitura rapida do estado atual da automacao.</p>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item px-0 d-flex justify-content-between"><span>Governanca geral</span><strong>@(Model.Governance.Enabled ? "Ativa" : "Desligada")</strong></li>
                        <li class="list-group-item px-0 d-flex justify-content-between"><span>Canais liberados</span><strong>@Model.Governance.AllowedChannelsLabel</strong></li>
                        <li class="list-group-item px-0 d-flex justify-content-between"><span>Intake</span><strong>@(Model.Governance.IntakeEnabled ? "ON" : "OFF")</strong></li>
                        <li class="list-group-item px-0 d-flex justify-content-between"><span>Maquina de estados</span><strong>@(Model.Governance.StageAutomationEnabled ? "ON" : "OFF")</strong></li>
                        <li class="list-group-item px-0 d-flex justify-content-between"><span>Matching</span><strong>@(Model.Governance.MatchingEnabled ? "ON" : "OFF")</strong></li>
                        <li class="list-group-item px-0 d-flex justify-content-between"><span>Dispatch</span><strong>@(Model.Governance.DispatchEnabled ? "ON" : "OFF")</strong></li>
                        <li class="list-group-item px-0 d-flex justify-content-between"><span>Conexao direta</span><strong>@(Model.Governance.ConnectionEnabled ? "ON" : "OFF")</strong></li>
                        <li class="list-group-item px-0 d-flex justify-content-between"><span>Encerramento</span><strong>@(Model.Governance.ClosureEnabled ? "ON" : "OFF")</strong></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-12 col-xxl-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5 mb-1">Conversao por canal</h2>
                    <p class="text-secondary small mb-3">Volume, conclusao e perdas por canal da jornada.</p>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Canal</th>
                                    <th class="text-end">Jornadas</th>
                                    <th class="text-end">Concluidas</th>
                                    <th class="text-end">Excecoes</th>
                                    <th class="text-end">Sem match</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Snapshot.SourceBreakdown)
                                {
                                    <tr>
                                        <td class="fw-semibold">@SourceLabel(item.SourceChannel)</td>
                                        <td class="text-end">@item.TotalJourneys</td>
                                        <td class="text-end">@item.CompletedJourneys</td>
                                        <td class="text-end">@item.OperationalExceptionJourneys</td>
                                        <td class="text-end">@item.NoMatchJourneys</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5 mb-1">Estados da jornada</h2>
                    <p class="text-secondary small mb-3">Onde a operacao esta ganhando ou perdendo casos.</p>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Estado</th>
                                    <th class="text-end">Jornadas</th>
                                    <th class="text-end">Concluidas</th>
                                    <th class="text-end">Excecoes</th>
                                    <th class="text-end">Sem match</th>
                                    <th class="text-end">Idade media</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Snapshot.StateBreakdown)
                                {
                                    <tr>
                                        <td class="fw-semibold">@StateLabel(item.CurrentState)</td>
                                        <td class="text-end">@item.TotalJourneys</td>
                                        <td class="text-end">@item.CompletedJourneys</td>
                                        <td class="text-end">@item.OperationalExceptionJourneys</td>
                                        <td class="text-end">@item.NoMatchJourneys</td>
                                        <td class="text-end">@HoursLabel(item.AverageJourneyAgeHours)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5 mb-1">Motivos de excecao</h2>
                    <p class="text-secondary small mb-3">Matriz de handoff minimo e saida do fluxo automatico.</p>
                    @if (Model.Snapshot.ExceptionReasons.Count == 0)
                    {
                        <div class="text-secondary small">Nenhuma excecao operacional registrada no recorte atual.</div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var item in Model.Snapshot.ExceptionReasons)
                            {
                                <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                    <span>@item.Reason</span>
                                    <span class="badge text-bg-dark rounded-pill">@item.TotalJourneys</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5 mb-1">Top categorias</h2>
                    <p class="text-secondary small mb-3">Leitura de conversao e perda por categoria.</p>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Categoria</th>
                                    <th class="text-end">Jornadas</th>
                                    <th class="text-end">Concluidas</th>
                                    <th class="text-end">Sem match</th>
                                    <th class="text-end">Excecoes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Snapshot.TopCategories)
                                {
                                    <tr>
                                        <td>@item.Category</td>
                                        <td class="text-end">@item.TotalJourneys</td>
                                        <td class="text-end">@item.CompletedJourneys</td>
                                        <td class="text-end">@item.NoMatchJourneys</td>
                                        <td class="text-end">@item.OperationalExceptionJourneys</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5 mb-1">Top cidades</h2>
                    <p class="text-secondary small mb-3">Recorte geografico para cobertura e rollout.</p>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Cidade</th>
                                    <th class="text-end">Jornadas</th>
                                    <th class="text-end">Concluidas</th>
                                    <th class="text-end">Sem match</th>
                                    <th class="text-end">Excecoes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Snapshot.TopCities)
                                {
                                    <tr>
                                        <td>@item.City</td>
                                        <td class="text-end">@item.TotalJourneys</td>
                                        <td class="text-end">@item.CompletedJourneys</td>
                                        <td class="text-end">@item.NoMatchJourneys</td>
                                        <td class="text-end">@item.OperationalExceptionJourneys</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5 mb-1">Conversao por onda</h2>
                    <p class="text-secondary small mb-3">Quantas jornadas precisaram de mais ondas para fechar.</p>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Onda</th>
                                    <th class="text-end">Jornadas</th>
                                    <th class="text-end">Reservadas</th>
                                    <th class="text-end">Concluidas</th>
                                    <th class="text-end">Excecoes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Snapshot.WaveBreakdown)
                                {
                                    <tr>
                                        <td class="fw-semibold">@item.WaveNumber</td>
                                        <td class="text-end">@item.TotalJourneys</td>
                                        <td class="text-end">@item.ReservedJourneys</td>
                                        <td class="text-end">@item.CompletedJourneys</td>
                                        <td class="text-end">@item.OperationalExceptionJourneys</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5 mb-1">Backlog por etapa</h2>
                    <p class="text-secondary small mb-3">Pressao operacional do board no momento.</p>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Board</th>
                                    <th>Etapa</th>
                                    <th class="text-end">Leads</th>
                                    <th class="text-end">Timer vencido</th>
                                    <th class="text-end">Excecoes</th>
                                    <th class="text-end">Sem match</th>
                                    <th class="text-end">Idade media</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Snapshot.StageBacklog)
                                {
                                    <tr>
                                        <td>@BoardLabel(item.BoardType)</td>
                                        <td class="fw-semibold">@item.StageName</td>
                                        <td class="text-end">@item.TotalLeads</td>
                                        <td class="text-end">@item.OverdueTimerJourneys</td>
                                        <td class="text-end">@item.OperationalExceptionJourneys</td>
                                        <td class="text-end">@item.NoMatchJourneys</td>
                                        <td class="text-end">@HoursLabel(item.AverageLeadAgeHours)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="offcanvas offcanvas-end" tabindex="-1" id="journeyInsightsFiltersDrawer" aria-labelledby="journeyInsightsFiltersDrawerLabel">
    <div class="offcanvas-header">
        <div>
            <h2 class="offcanvas-title h5 mb-1" id="journeyInsightsFiltersDrawerLabel">Filtros</h2>
            <p class="small text-secondary mb-0">Refine a leitura operacional e gerencial da jornada.</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fechar"></button>
    </div>
    <div class="offcanvas-body">
        <form method="get" asp-area="Admin" asp-controller="JourneyInsights" asp-action="Index" class="d-grid gap-3">
            <div>
                <label class="form-label" for="journeyBoardType">Board</label>
                <select class="form-select" id="journeyBoardType" name="boardType">
                    <option value="" selected="@(string.IsNullOrWhiteSpace(Model.SelectedBoardType) ? "selected" : null)">Todos os boards</option>
                    <option value="clientes" selected="@(Model.SelectedBoardType == "clientes" ? "selected" : null)">Clientes</option>
                    <option value="prestadores" selected="@(Model.SelectedBoardType == "prestadores" ? "selected" : null)">Prestadores</option>
                </select>
            </div>
            <div>
                <label class="form-label" for="journeySourceChannel">Canal</label>
                <select class="form-select" id="journeySourceChannel" name="sourceChannel">
                    <option value="" selected="@(string.IsNullOrWhiteSpace(Model.SelectedSourceChannel) ? "selected" : null)">Todos os canais</option>
                    <option value="landing" selected="@(Model.SelectedSourceChannel == "landing" ? "selected" : null)">Landing / Site</option>
                    <option value="telegram" selected="@(Model.SelectedSourceChannel == "telegram" ? "selected" : null)">Telegram</option>
                    <option value="service_request" selected="@(Model.SelectedSourceChannel == "service_request" ? "selected" : null)">Portal do Cliente</option>
                </select>
            </div>
            <div>
                <label class="form-label" for="journeyStartDate">Data inicial</label>
                <input class="form-control" type="date" id="journeyStartDate" name="startDate" value="@Model.PeriodStartValue" />
            </div>
            <div>
                <label class="form-label" for="journeyEndDate">Data final</label>
                <input class="form-control" type="date" id="journeyEndDate" name="endDate" value="@Model.PeriodEndValue" />
            </div>
            <div class="d-flex gap-2 pt-2">
                <button type="submit" class="btn btn-primary flex-fill">Aplicar filtros</button>
                <a class="btn btn-outline-secondary flex-fill" href="@Model.FiltersClearUrl">Limpar filtros</a>
            </div>
        </form>
    </div>
</div>
