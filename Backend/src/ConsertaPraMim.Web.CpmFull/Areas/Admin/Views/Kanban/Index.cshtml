                    } catch { }

                    alert(error.message || "Nao foi possivel sincronizar o lead com Chatwoot.");
                } finally {
                    button.disabled = false;
                    button.textContent = originalText;
                }
            });

            document.getElementById("enqueueLeadChatwootRetryBtn")?.addEventListener("click", async (event) => {
                if (!currentLead?.id) {
                    return;
                }

                const button = event.currentTarget;
                const originalText = button.textContent;
                button.disabled = true;
                button.textContent = "Enfileirando...";

                try {
                    const response = await postJson(endpoint.retry(currentLead.id), {});
                    currentLead = await loadLeadDetails(currentLead.id);
                    fillDetails(currentLead);
                    alert(response.message || "Retentativa do Chatwoot enfileirada.");
                } catch (error) {
                    try {
                        currentLead = await loadLeadDetails(currentLead.id);
                        fillDetails(currentLead);
                    } catch { }

                    alert(error.message || "Nao foi possivel enfileirar a retentativa do Chatwoot.");
                } finally {
                    button.disabled = false;
                    button.textContent = originalText;
                }
            });

            document.getElementById("deleteLeadBtn")?.addEventListener("click", async (event) => {
                if (!currentLead?.id) {
                    return;
                }

                const deleteChatwootContact = document.getElementById("deleteLeadChatwootContactCheckbox")?.checked === true;
                const confirmed = window.confirm(
                    deleteChatwootContact
                        ? "Excluir este lead do CPM Full?\n\nEssa acao remove o lead, o historico, o vinculo Telegram e as filas locais relacionadas.\nO contato remoto tambem sera apagado no Chatwoot antes do reset local."
                        : "Excluir este lead do CPM Full?\n\nEssa acao remove o lead, o historico, o vinculo Telegram e as filas locais relacionadas.\nO contato no Chatwoot nao sera apagado automaticamente."
                );
                if (!confirmed) {
                    return;
                }

                const button = event.currentTarget;
                const originalText = button.textContent;
                button.disabled = true;
                button.textContent = "Excluindo...";

                try {
                    const response = await postJson(endpoint.deleteLead(currentLead.id), {
                        deleteChatwootContact
                    });
                    detailsModal?.hide();
                    alert(response.message || "Lead excluido com sucesso.");
                    window.location.reload();
                } catch (error) {
                    alert(error.message || "Nao foi possivel excluir o lead.");
                } finally {
                    button.disabled = false;
                    button.textContent = originalText;
                }
            });

            document.getElementById("toggleTelegramHandoffBtn")?.addEventListener("click", async (event) => {
                if (!currentLead?.id) {
                    return;
                }

                const button = event.currentTarget;
                const action = button.dataset.action || "activate";
                const isResume = action === "resume";
                const confirmed = window.confirm(
                    isResume
                        ? "Retomar o bot neste chat Telegram?\n\nO proximo contato do usuario podera voltar ao fluxo automatico."
                        : "Ativar handoff humano neste chat Telegram?\n\nEnquanto o handoff estiver ativo, o bot deixara de responder automaticamente."
                );
                if (!confirmed) {
                    return;
                }

                const originalText = button.textContent;
                button.disabled = true;
                button.textContent = isResume ? "Retomando..." : "Ativando...";

                try {
                    const response = await postJson(
                        isResume ? endpoint.resumeTelegramBot(currentLead.id) : endpoint.activateTelegramHandoff(currentLead.id),
                        {});
                    currentLead = await loadLeadDetails(currentLead.id);
                    fillDetails(currentLead);
                    alert(response.message || (isResume ? "Bot retomado com sucesso." : "Handoff ativado com sucesso."));
                } catch (error) {
                    try {
                        currentLead = await loadLeadDetails(currentLead.id);
                        fillDetails(currentLead);
                    } catch { }

                    alert(error.message || "Nao foi possivel atualizar o handoff Telegram.");
                } finally {
                    button.disabled = false;
                    if (!currentLead?.telegram?.canManageHandoff) {
                        button.textContent = originalText;
                    }
                }
            });

            document.getElementById("saveEditLeadBtn")?.addEventListener("click", async () => {
                const payload = getFormValues("edit");
                if (!payload.id || !payload.name) {
                    alert("Preencha os dados obrigatorios do lead.");
                    return;
                }

                try {
                    await postJson(endpoint.update, payload);
                    window.location.reload();
                } catch (error) {
                    alert(error.message || "Nao foi possivel atualizar o lead.");
                }
            });

            document.getElementById("addLeadNoteBtn")?.addEventListener("click", async () => {
                if (!currentLead?.id) return;
                const noteInput = document.getElementById("leadNoteInput");
                const note = noteInput?.value?.trim() || "";
                if (!note) {
                    alert("Digite uma anotacao para salvar.");
                    return;
                }

                try {
                    await postJson(endpoint.note, { leadId: currentLead.id, note });
                    noteInput.value = "";
                    currentLead = await loadLeadDetails(currentLead.id);
                    fillDetails(currentLead);
                } catch (error) {
                    alert(error.message || "Nao foi possivel salvar a anotacao.");
                }
            });

            backfillModalEl?.addEventListener("show.bs.modal", () => {
                resetBackfillResult();
            });

            document.getElementById("runChatwootBackfillBtn")?.addEventListener("click", async (event) => {
                const button = event.currentTarget;
                const originalText = button.textContent;
                const batchSize = Number(document.getElementById("backfillBatchSize")?.value || "20");
                const boardScope = document.getElementById("backfillBoardScope")?.value || "";
                const startAfterLeadIdText = document.getElementById("backfillStartAfterLeadId")?.value || "";
                const dryRun = document.getElementById("backfillDryRun")?.checked ?? false;

                button.disabled = true;
                button.textContent = dryRun ? "Validando..." : "Processando...";

                try {
                    const response = await postJson(endpoint.backfill, {
                        boardType: boardScope,
                        batchSize,
                        dryRun,
                        startAfterLeadId: startAfterLeadIdText ? Number(startAfterLeadIdText) : null
                    });

                    renderBackfillResult(response);
                } catch (error) {
                    resetBackfillResult();
                    alert(error.message || "Nao foi possivel executar o backfill do Chatwoot.");
                } finally {
                    button.disabled = false;
                    button.textContent = originalText;
                }
            });

            diagnosticsDrawerEl?.addEventListener("show.bs.offcanvas", async () => {
                resetDiagnosticsTables();
                try {
                    await loadChatwootDiagnostics(true);
                } catch (error) {
                    setDiagnosticsAlert(error.message || "Nao foi possivel carregar o diagnostico do Chatwoot.", "danger");
                }
            });

            document.getElementById("applyChatwootDiagnosticsFiltersBtn")?.addEventListener("click", async () => {
                try {
                    await loadChatwootDiagnostics(true);
                } catch (error) {
                    setDiagnosticsAlert(error.message || "Nao foi possivel aplicar os filtros do diagnostico.", "danger");
                }
            });

            document.getElementById("resetChatwootDiagnosticsFiltersBtn")?.addEventListener("click", async () => {
                const boardScopeInput = document.getElementById("chatwootDiagnosticsBoardScope");
                const limitInput = document.getElementById("chatwootDiagnosticsLimit");
                if (boardScopeInput) {
                    boardScopeInput.value = defaultDiagnosticsBoardScope;
                }

                if (limitInput) {
                    limitInput.value = String(defaultDiagnosticsLimit);
                }

                try {
                    await loadChatwootDiagnostics(true);
                } catch (error) {
                    setDiagnosticsAlert(error.message || "Nao foi possivel limpar os filtros do diagnostico.", "danger");
                }
            });

            document.getElementById("refreshChatwootDiagnosticsBtn")?.addEventListener("click", async () => {
                try {
                    await loadChatwootDiagnostics(true);
                } catch (error) {
                    setDiagnosticsAlert(error.message || "Nao foi possivel atualizar o diagnostico do Chatwoot.", "danger");
                }
            });

            diagnosticsDrawerEl?.addEventListener("click", async (event) => {
                const retryButton = event.target.closest("[data-chatwoot-retry]");
                if (retryButton) {
                    const leadId = Number(retryButton.getAttribute("data-chatwoot-retry") || "0");
                    if (!leadId) {
                        return;
                    }

                    retryButton.setAttribute("disabled", "disabled");
                    try {
                        const response = await postJson(endpoint.retry(leadId), {});
                        setDiagnosticsAlert(response.message || "Retentativa do Chatwoot enfileirada.", "success");
                        if (currentLead?.id === leadId) {
                            currentLead = await loadLeadDetails(leadId);
                            fillDetails(currentLead);
                        }

                        await loadChatwootDiagnostics();
                    } catch (error) {
                        setDiagnosticsAlert(error.message || "Nao foi possivel enfileirar a retentativa do Chatwoot.", "danger");
                    } finally {
                        retryButton.removeAttribute("disabled");
                    }

                    return;
                }

                const openLeadButton = event.target.closest("[data-chatwoot-open-lead]");
                if (openLeadButton) {
                    const leadId = Number(openLeadButton.getAttribute("data-chatwoot-open-lead") || "0");
                    if (!leadId) {
                        return;
                    }

                    try {
                        currentLead = await loadLeadDetails(leadId);
                        fillDetails(currentLead);
                        diagnosticsDrawer?.hide();
                        detailsModal?.show();
                    } catch (error) {
                        setDiagnosticsAlert(error.message || "Nao foi possivel carregar o lead selecionado.", "danger");
                    }
                }
            });

            telegramDiagnosticsDrawerEl?.addEventListener("show.bs.offcanvas", async () => {
                resetTelegramDiagnosticsTables();
                try {
                    await loadTelegramDiagnostics(true);
                } catch (error) {
                    setTelegramDiagnosticsAlert(error.message || "Nao foi possivel carregar o diagnostico do Telegram.", "danger");
                }
            });

            document.getElementById("applyTelegramDiagnosticsFiltersBtn")?.addEventListener("click", async () => {
                try {
                    await loadTelegramDiagnostics(true);
                } catch (error) {
                    setTelegramDiagnosticsAlert(error.message || "Nao foi possivel aplicar os filtros do diagnostico Telegram.", "danger");
                }
            });

            document.getElementById("resetTelegramDiagnosticsFiltersBtn")?.addEventListener("click", async () => {
                const boardScopeInput = document.getElementById("telegramDiagnosticsBoardScope");
                const limitInput = document.getElementById("telegramDiagnosticsLimit");
                if (boardScopeInput) {
                    boardScopeInput.value = defaultTelegramDiagnosticsBoardScope;
                }

                if (limitInput) {
                    limitInput.value = String(defaultTelegramDiagnosticsLimit);
                }

                try {
                    await loadTelegramDiagnostics(true);
                } catch (error) {
                    setTelegramDiagnosticsAlert(error.message || "Nao foi possivel limpar os filtros do diagnostico Telegram.", "danger");
                }
            });

            document.getElementById("refreshTelegramDiagnosticsBtn")?.addEventListener("click", async () => {
                try {
                    await loadTelegramDiagnostics(true);
                } catch (error) {
                    setTelegramDiagnosticsAlert(error.message || "Nao foi possivel atualizar o diagnostico do Telegram.", "danger");
                }
            });

            telegramDiagnosticsDrawerEl?.addEventListener("click", async (event) => {
                const retryButton = event.target.closest("[data-telegram-retry-queue]");
                if (retryButton) {
                    const queueItemId = Number(retryButton.getAttribute("data-telegram-retry-queue") || "0");
                    if (!queueItemId) {
                        return;
                    }

                    retryButton.setAttribute("disabled", "disabled");
                    try {
                        const response = await postJson(endpoint.telegramRetryQueue(queueItemId), {});
                        setTelegramDiagnosticsAlert(response.message || "Retentativa Telegram enfileirada.", "success");
                        if (currentLead?.id === response.leadId) {
                            currentLead = await loadLeadDetails(response.leadId);
                            fillDetails(currentLead);
                        }

                        await loadTelegramDiagnostics();
                    } catch (error) {
                        setTelegramDiagnosticsAlert(error.message || "Nao foi possivel enfileirar a retentativa Telegram.", "danger");
                    } finally {
                        retryButton.removeAttribute("disabled");
                    }

                    return;
                }

                const openLeadButton = event.target.closest("[data-telegram-open-lead]");
                if (openLeadButton) {
                    const leadId = Number(openLeadButton.getAttribute("data-telegram-open-lead") || "0");
                    if (!leadId) {
                        return;
                    }

                    try {
                        currentLead = await loadLeadDetails(leadId);
                        fillDetails(currentLead);
                        telegramDiagnosticsDrawer?.hide();
                        detailsModal?.show();
                    } catch (error) {
                        setTelegramDiagnosticsAlert(error.message || "Nao foi possivel carregar o lead selecionado.", "danger");
                    }
                }
            });

            updateStageCounts();
            updateChatwootSummary();
            updateAllCardStageAges();
            window.setInterval(updateAllCardStageAges, 60000);
        })();
    </script>
}
