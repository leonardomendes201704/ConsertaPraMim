@model AppMobileCPM.ViewModels.JourneyServiceClosurePageViewModel
@{
    ViewData["Title"] = Model.Title;
}

<style>
    .journey-shell { min-height: 100vh; display: grid; place-items: center; padding: 32px 20px; background: linear-gradient(180deg, #f6fbff 0%, #eef4f8 100%); color: #102a43; font-family: "Segoe UI", Arial, sans-serif; }
    .journey-card { width: min(780px, 100%); background: #fff; border: 1px solid #d9e2ec; border-radius: 24px; padding: 32px; box-shadow: 0 24px 70px rgba(16,42,67,.12); }
    .journey-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .journey-panel { border-radius: 18px; background: #f8fbfd; border: 1px solid #d9e2ec; padding: 18px; }
    .journey-feedback { margin: 0 0 20px; padding: 14px 16px; border-radius: 14px; background: #eff6ff; border: 1px solid #bfdbfe; }
    .journey-feedback.success { background: #ecfdf3; border-color: #86efac; color: #166534; }
    .journey-feedback.warning { background: #fff7ed; border-color: #fdba74; color: #9a3412; }
    .journey-form { display: grid; gap: 16px; }
    .journey-form select, .journey-form textarea, .journey-form button { width: 100%; border-radius: 12px; padding: 14px 16px; font: inherit; box-sizing: border-box; }
    .journey-form select, .journey-form textarea { border: 1px solid #cbd5e1; }
    .journey-form button { border: 0; background: #0f766e; color: #fff; font-weight: 700; }
</style>

<main class="journey-shell">
    <article class="journey-card">
        <p style="margin:0 0 12px;text-transform:uppercase;letter-spacing:.12em;font-size:12px;color:#486581;">ConsertaPraMim</p>
        <h1 style="margin:0 0 12px;font-size:32px;line-height:1.15;">@Model.ResponseHeadline</h1>
        <p style="margin:0 0 24px;font-size:16px;line-height:1.7;color:#334e68;">@Model.ResponseDescription</p>

        @if (!string.IsNullOrWhiteSpace(Model.FeedbackMessage))
        {
            <div class="journey-feedback @(Model.ActionSucceeded ? "success" : "warning")">@Model.FeedbackMessage</div>
        }

        <section class="journey-grid">
            <div class="journey-panel"><strong>Parte avaliada</strong><span>@(string.IsNullOrWhiteSpace(Model.CounterpartyName) ? "-" : Model.CounterpartyName)</span></div>
            <div class="journey-panel"><strong>Categoria</strong><span>@(string.IsNullOrWhiteSpace(Model.RequestedCategory) ? "-" : Model.RequestedCategory)</span></div>
            <div class="journey-panel"><strong>Janela</strong><span>@(string.IsNullOrWhiteSpace(Model.ScheduledWindowLabel) ? "-" : Model.ScheduledWindowLabel)</span></div>
            <div class="journey-panel" style="grid-column:1/-1;"><strong>Endereco</strong><span>@(string.IsNullOrWhiteSpace(Model.AddressSummary) ? "-" : Model.AddressSummary)</span></div>
        </section>

        @if (Model.CanRespond && !Model.ActionCompleted)
        {
            <form asp-controller="JourneyServiceClosure" asp-action="ReviewSubmit" method="post" class="journey-form">
                <input type="hidden" name="token" value="@Model.Token" />
                <input type="hidden" name="audience" value="@Model.Audience" />
                <label>
                    <span style="display:block;margin-bottom:8px;font-weight:700;">Nota</span>
                    <select name="rating">
                        <option value="5">5 - Excelente</option>
                        <option value="4">4 - Muito bom</option>
                        <option value="3">3 - Regular</option>
                        <option value="2">2 - Ruim</option>
                        <option value="1">1 - Muito ruim</option>
                    </select>
                </label>
                <label>
                    <span style="display:block;margin-bottom:8px;font-weight:700;">Comentario</span>
                    <textarea name="comment" rows="4" placeholder="Descreva como foi a experiencia deste atendimento."></textarea>
                </label>
                <label>
                    <span style="display:block;margin-bottom:8px;font-weight:700;">Motivo de nota baixa (se aplicavel)</span>
                    <textarea name="lowScoreReason" rows="3" placeholder="Preencha quando a nota for baixa."></textarea>
                </label>
                <label>
                    <span style="display:block;margin-bottom:8px;font-weight:700;">Voltaria a contratar / atender novamente?</span>
                    <select name="wouldHireAgain">
                        <option value="">Prefiro nao informar</option>
                        <option value="true">Sim</option>
                        <option value="false">Nao</option>
                    </select>
                </label>
                <button type="submit">Enviar avaliacao</button>
            </form>
        }
    </article>
</main>
