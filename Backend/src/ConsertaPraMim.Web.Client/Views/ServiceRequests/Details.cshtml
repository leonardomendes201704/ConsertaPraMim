@using ConsertaPraMim.Application.DTOs
@using ConsertaPraMim.Web.Client.Services
@inject IConfiguration Configuration
@model ConsertaPraMim.Application.DTOs.ServiceRequestDto
@{
    ViewData["Title"] = "Detalhes do Pedido";
    var proposals = (ViewBag.Proposals as IEnumerable<ConsertaPraMim.Application.DTOs.ProposalDto>)?.ToList()
        ?? new List<ConsertaPraMim.Application.DTOs.ProposalDto>();
    var providerReputations = ViewBag.ProviderReputations as IReadOnlyDictionary<Guid, ConsertaPraMim.Application.DTOs.ReviewScoreSummaryDto>
        ?? new Dictionary<Guid, ConsertaPraMim.Application.DTOs.ReviewScoreSummaryDto>();
    var acceptedProviders = ViewBag.AcceptedProviders as IEnumerable<ConsertaPraMim.Web.Client.Controllers.ServiceRequestsController.AcceptedProviderOptionDto>
        ?? Enumerable.Empty<ConsertaPraMim.Web.Client.Controllers.ServiceRequestsController.AcceptedProviderOptionDto>();
    var appointments = ViewBag.Appointments as IEnumerable<object> ?? Enumerable.Empty<object>();
    var evidences = ViewBag.Evidences as IEnumerable<object> ?? Enumerable.Empty<object>();
    var scopeChanges = ViewBag.ScopeChanges as IEnumerable<object> ?? Enumerable.Empty<object>();
    var warrantyClaims = ViewBag.WarrantyClaims as IEnumerable<object> ?? Enumerable.Empty<object>();
    var disputes = ViewBag.Disputes as IEnumerable<object> ?? Enumerable.Empty<object>();
    var appointmentPayload = ViewBag.AppointmentPayload;
    var apiBaseUrl = ClientPublicUrlResolver.ResolveApiBaseUrl(
        Configuration["BrowserApiBaseUrl"] ?? Configuration["ApiBaseUrl"],
        (Context.Request.Host.Host ?? string.Empty).Trim(),
        "http://localhost:5193");
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
    var statusBadgeClass = Model.Status switch
    {
        "Created" => "bg-info",
        "Matching" => "bg-primary",
        "Scheduled" => "bg-warning",
        "InProgress" => "bg-primary",
        "PendingClientCompletionAcceptance" => "bg-info",
        "Completed" => "bg-success",
        "Validated" => "bg-success",
        "Canceled" => "bg-secondary",
        _ => "bg-secondary"
    };
    var statusBadgeLabel = Model.Status switch
    {
        "Created" => "Criado",
        "Matching" => "Buscando prestadores",
        "Scheduled" => "Agendado",
        "InProgress" => "Em atendimento",
        "PendingClientCompletionAcceptance" => "Aguardando aceite de conclusao",
        "Completed" => "Concluido",
        "Validated" => "Validado",
        "Canceled" => "Cancelado",
        _ => string.IsNullOrWhiteSpace(Model.Status) ? "Sem status" : Model.Status
    };

    var acceptedProvidersJson = System.Text.Json.JsonSerializer.Serialize(
        acceptedProviders.Select(p => new
        {
            providerId = p.ProviderId,
            providerName = p.ProviderName
        }));

    var comparablePrices = proposals
        .Where(proposal => !proposal.Invalidated && proposal.EstimatedValue.HasValue)
        .Select(proposal => proposal.EstimatedValue!.Value)
        .ToList();
    var comparableLeadTimes = proposals
        .Where(proposal => !proposal.Invalidated && proposal.EstimatedLeadTimeHours.HasValue)
        .Select(proposal => proposal.EstimatedLeadTimeHours!.Value)
        .ToList();
    var comparableWarranties = proposals
        .Where(proposal => !proposal.Invalidated && proposal.WarrantyDays.HasValue)
        .Select(proposal => proposal.WarrantyDays!.Value)
        .ToList();
    var maxReviewCount = proposals
        .Select(proposal => providerReputations.TryGetValue(proposal.ProviderId, out var reputation)
            ? reputation.TotalReviews
            : 0)
        .DefaultIfEmpty(0)
        .Max();

    var lowestComparablePrice = comparablePrices.Count > 0 ? comparablePrices.Min() : (decimal?)null;
    var fastestComparableLeadTime = comparableLeadTimes.Count > 0 ? comparableLeadTimes.Min() : (int?)null;
    var highestComparableWarranty = comparableWarranties.Count > 0 ? comparableWarranties.Max() : (int?)null;
    var providerReputationsJson = System.Text.Json.JsonSerializer.Serialize(
        providerReputations.ToDictionary(
            entry => entry.Key,
            entry => new
            {
                averageRating = entry.Value.AverageRating,
                totalReviews = entry.Value.TotalReviews
            }));

    var initialAppointmentJson = appointmentPayload == null
        ? "null"
        : System.Text.Json.JsonSerializer.Serialize(appointmentPayload);

    var initialAppointmentsJson = System.Text.Json.JsonSerializer.Serialize(appointments);
    var initialEvidencesJson = System.Text.Json.JsonSerializer.Serialize(evidences);
    var initialScopeChangesJson = System.Text.Json.JsonSerializer.Serialize(scopeChanges);
    var initialWarrantyClaimsJson = System.Text.Json.JsonSerializer.Serialize(warrantyClaims);
    var initialDisputesJson = System.Text.Json.JsonSerializer.Serialize(disputes);
	    var canStartPayment = string.Equals(Model.Status, "Completed", StringComparison.OrdinalIgnoreCase);
	    var supportHelpDetails = ViewBag.SupportHelpTicket as ClientSupportTicketDetailsDto;
	    var supportHelpTicket = supportHelpDetails?.Ticket;
	    var supportHelpMessages = supportHelpDetails?.Messages ?? Array.Empty<ClientSupportTicketMessageDto>();
	    var reviewFeedbackIcon = TempData["ReviewFeedbackIcon"] as string;
	    var reviewFeedbackTitle = TempData["ReviewFeedbackTitle"] as string;
	    var reviewFeedbackMessage = TempData["ReviewFeedbackMessage"] as string;

    string SupportTicketStatusLabel(string? status)
    {
        return (status ?? string.Empty).ToLowerInvariant() switch
        {
            "open" => "Aberto",
            "inprogress" => "Em atendimento",
            "waitingprovider" => "Aguardando seu retorno",
            "resolved" => "Resolvido",
            "closed" => "Encerrado",
            _ => string.IsNullOrWhiteSpace(status) ? "Sem status" : status
        };
    }

    string SupportTicketStatusBadgeClass(string? status)
    {
        return (status ?? string.Empty).ToLowerInvariant() switch
        {
            "open" => "bg-primary-subtle text-primary-emphasis border border-primary-subtle",
            "inprogress" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
            "waitingprovider" => "bg-info-subtle text-info-emphasis border border-info-subtle",
            "resolved" => "bg-success-subtle text-success-emphasis border border-success-subtle",
            "closed" => "bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle",
            _ => "bg-light text-dark border border-light-subtle"
        };
    }

    string SupportAuthorBadgeClass(string? authorRole)
    {
        return (authorRole ?? string.Empty).ToLowerInvariant() switch
        {
            "admin" => "bg-primary-subtle text-primary-emphasis border border-primary-subtle",
            "client" => "bg-success-subtle text-success-emphasis border border-success-subtle",
            _ => "bg-light text-dark border border-light-subtle"
        };
    }

    string SupportAttachmentIconClass(string? mediaKind)
    {
        return (mediaKind ?? string.Empty).ToLowerInvariant() switch
        {
            "image" => "fas fa-image text-primary",
            "video" => "fas fa-video text-danger",
            "audio" => "fas fa-volume-high text-success",
            _ => "fas fa-file-lines text-secondary"
        };
    }

    string SupportAttachmentActionLabel(string? mediaKind)
    {
        return (mediaKind ?? string.Empty).ToLowerInvariant() switch
        {
            "image" => "Visualizar imagem",
            "video" => "Visualizar video",
            "audio" => "Ouvir audio",
            _ => "Abrir anexo"
        };
    }

    string FormatAttachmentSize(long sizeBytes)
    {
        if (sizeBytes < 1024) return $"{sizeBytes} B";
        if (sizeBytes < 1024 * 1024) return $"{sizeBytes / 1024d:0.#} KB";
        return $"{sizeBytes / (1024d * 1024d):0.##} MB";
    }
}

<div class="container py-4">
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 mb-2">@Model.Category</span>
                            <h2 class="fw-bold mb-0">@Model.Description</h2>
                        </div>
                        <div class="text-end">
                            <span class="text-muted d-block small">Status do Pedido</span>
                            <span id="request-status-badge" class="badge @statusBadgeClass rounded-pill px-3 py-2 fs-6">@statusBadgeLabel</span>
                            <span class="text-muted d-block small mt-2">Pagamento</span>
                            <span id="payment-status-summary-badge" class="badge bg-light text-muted border border-light-subtle rounded-pill px-3 py-2">Sem pagamento</span>
                        </div>
                    </div>

                    <div class="row g-4 pt-3 border-top">
                        <div class="col-md-6">
                            <h6 class="text-uppercase text-muted fw-bold mb-2" style="font-size: 0.7rem; letter-spacing: 1px;">Localizacao</h6>
                            <p class="mb-0 fw-semibold"><i class="fas fa-map-marker-alt text-danger me-2"></i> @Model.Street, @Model.City</p>
                            <small class="text-muted">CEP: @Model.Zip</small>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-uppercase text-muted fw-bold mb-2" style="font-size: 0.7rem; letter-spacing: 1px;">Data da Solicitacao</h6>
                            <p class="mb-0 fw-semibold"><i class="far fa-calendar-alt text-primary me-2"></i> @Model.CreatedAt.ToLongDateString()</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mt-4">
                            <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.7rem; letter-spacing: 1px;">Foto do Problema</h6>
                            <img src="@Model.ImageUrl" class="img-fluid rounded-4 shadow-sm" style="max-height: 300px;" alt="Foto do pedido">
                        </div>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-3">
                    <div class="nav request-details-tabs" role="tablist" aria-label="Secoes de detalhes do pedido">
                        <button type="button" class="nav-link request-tab-trigger" data-target="proposals">Propostas Recebidas (@proposals.Count)</button>
                        <button type="button" class="nav-link request-tab-trigger active" data-target="appointment">Agendamento do Servico</button>
                        <button type="button" class="nav-link request-tab-trigger" data-target="scope">Aditivos de Escopo</button>
                        <button type="button" class="nav-link request-tab-trigger" data-target="warranty">Historico de Garantia</button>
                        <button type="button" class="nav-link request-tab-trigger" data-target="disputes">Historico de Disputas</button>
                        <button type="button" class="nav-link request-tab-trigger" data-target="evidences">Evidencias do Servico</button>
                        <button type="button" class="nav-link request-tab-trigger" data-target="comparison">Comparador de Propostas</button>
                        <button type="button" class="nav-link request-tab-trigger" data-target="receipts">Comprovantes de Pagamento</button>
                        <button type="button" class="nav-link request-tab-trigger" data-target="payment">Pagamento do Servico</button>
                        <button type="button" class="nav-link request-tab-trigger" data-target="security">Dicas de Seguranca</button>
                        <button type="button" class="nav-link request-tab-trigger" data-target="help">Precisa de ajuda?</button>
                    </div>
                </div>
            </div>

            <section class="details-tab-pane active" data-pane="appointment">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="fw-bold mb-0"><i class="fas fa-calendar-check text-primary me-2"></i>Agendamento do Servico</h4>
                        <span class="text-muted small">Sem refresh completo</span>
                    </div>
                    <div id="appointment-feedback" class="alert d-none" role="alert"></div>
                    <div id="appointment-section"></div>
                </div>
            </div>
            </section>

            <section class="details-tab-pane" data-pane="scope">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="fw-bold mb-0"><i class="fas fa-arrows-rotate text-primary me-2"></i>Aditivos de Escopo</h4>
                        <span class="text-muted small">Historico com versoes</span>
                    </div>
                    <div id="scope-change-timeline-section"></div>
                </div>
            </div>
            </section>

            <section class="details-tab-pane" data-pane="warranty">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="fw-bold mb-0"><i class="fas fa-shield-heart text-primary me-2"></i>Historico de Garantia</h4>
                        <span class="text-muted small">Linha do tempo completa</span>
                    </div>
                    <div id="warranty-timeline-section"></div>
                </div>
            </div>
            </section>

            <section class="details-tab-pane" data-pane="disputes">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="fw-bold mb-0"><i class="fas fa-scale-balanced text-primary me-2"></i>Historico de Disputas</h4>
                        <span class="text-muted small">Mediacao e evidencias</span>
                    </div>
                    <div id="dispute-timeline-section"></div>
                </div>
            </div>
            </section>

            <section class="details-tab-pane" data-pane="evidences">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="fw-bold mb-0"><i class="fas fa-camera-retro text-primary me-2"></i>Evidencias do Servico</h4>
                        <span class="text-muted small">Ordenacao temporal</span>
                    </div>
                    <div id="evidence-timeline-section"></div>
                </div>
            </div>
            </section>

            <section class="details-tab-pane" data-pane="comparison">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <h4 class="fw-bold mb-0"><i class="fas fa-scale-balanced text-primary me-2"></i>Comparador de Propostas</h4>
                        <span class="text-muted small">@proposals.Count proposta(s)</span>
                    </div>

                    @if (!proposals.Any())
                    {
                        <p class="text-muted mb-0">Ainda nao ha propostas para comparar.</p>
                    }
                    else
                    {
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label for="proposal-comparison-sort" class="form-label small text-uppercase text-muted fw-bold mb-1">Ordenar por</label>
                                <select id="proposal-comparison-sort" class="form-select form-select-sm">
                                    <option value="best_score">Melhor score</option>
                                    <option value="lowest_price">Menor preco</option>
                                    <option value="fastest_lead_time">Menor prazo</option>
                                    <option value="best_rating">Melhor avaliacao</option>
                                    <option value="highest_warranty">Maior garantia</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex flex-wrap gap-2 justify-content-md-end align-items-center h-100 pt-md-4">
                                    <span class="badge text-bg-light border">Menor preco: @(lowestComparablePrice.HasValue ? lowestComparablePrice.Value.ToString("C") : "N/I")</span>
                                    <span class="badge text-bg-light border">Melhor prazo: @(fastestComparableLeadTime.HasValue ? $"{fastestComparableLeadTime.Value}h" : "N/I")</span>
                                    <span class="badge text-bg-light border">Maior garantia: @(highestComparableWarranty.HasValue ? $"{highestComparableWarranty.Value}d" : "N/I")</span>
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table align-middle" id="proposal-comparison-table">
                                <thead>
                                    <tr class="text-uppercase small text-muted">
                                        <th>#</th>
                                        <th>Prestador</th>
                                        <th>Valor</th>
                                        <th>Prazo</th>
                                        <th>Garantia</th>
                                        <th>Avaliacao</th>
                                        <th>Score</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="proposal-comparison-body">
                                    @foreach (var prop in proposals)
                                    {
                                        providerReputations.TryGetValue(prop.ProviderId, out var providerReputation);
                                        var providerRating = providerReputation?.AverageRating ?? 0d;
                                        var providerReviews = providerReputation?.TotalReviews ?? 0;
                                        var trustStatusLabel = prop.ProviderTrustStatus switch
                                        {
                                            ConsertaPraMim.Domain.Enums.ProviderTrustStatus.Verified => "Verificado",
                                            ConsertaPraMim.Domain.Enums.ProviderTrustStatus.Restricted => "Restrito",
                                            _ => "Em analise"
                                        };
                                        var trustBadgeClass = prop.ProviderTrustStatus switch
                                        {
                                            ConsertaPraMim.Domain.Enums.ProviderTrustStatus.Verified => "bg-success-subtle text-success border border-success-subtle",
                                            ConsertaPraMim.Domain.Enums.ProviderTrustStatus.Restricted => "bg-danger-subtle text-danger border border-danger-subtle",
                                            _ => "bg-warning-subtle text-warning border border-warning-subtle"
                                        };

                                        var priceComponent = 45d;
                                        if (prop.EstimatedValue.HasValue && lowestComparablePrice.HasValue && prop.EstimatedValue.Value > 0)
                                        {
                                            var ratio = (double)(lowestComparablePrice.Value / prop.EstimatedValue.Value) * 100d;
                                            priceComponent = Math.Clamp(ratio, 20d, 100d);
                                        }

                                        var leadComponent = 45d;
                                        if (prop.EstimatedLeadTimeHours.HasValue && fastestComparableLeadTime.HasValue && prop.EstimatedLeadTimeHours.Value > 0)
                                        {
                                            var ratio = (double)fastestComparableLeadTime.Value / prop.EstimatedLeadTimeHours.Value * 100d;
                                            leadComponent = Math.Clamp(ratio, 20d, 100d);
                                        }

                                        var warrantyComponent = 40d;
                                        if (prop.WarrantyDays.HasValue)
                                        {
                                            if (highestComparableWarranty.HasValue && highestComparableWarranty.Value > 0)
                                            {
                                                var ratio = (double)prop.WarrantyDays.Value / highestComparableWarranty.Value * 100d;
                                                warrantyComponent = Math.Clamp(ratio, 10d, 100d);
                                            }
                                            else
                                            {
                                                warrantyComponent = 60d;
                                            }
                                        }

                                        var ratingComponent = providerRating > 0d
                                            ? Math.Clamp(providerRating / 5d * 100d, 0d, 100d)
                                            : 35d;

                                        var historyComponent = maxReviewCount > 0
                                            ? Math.Clamp((double)providerReviews / maxReviewCount * 100d, 0d, 100d)
                                            : (providerReviews > 0 ? 70d : 35d);

                                        var calculatedRawScore = prop.Invalidated
                                            ? 0d
                                            : (priceComponent * 0.35d)
                                                + (leadComponent * 0.20d)
                                                + (warrantyComponent * 0.15d)
                                                + (ratingComponent * 0.20d)
                                                + (historyComponent * 0.10d)
                                                + (prop.Accepted ? 5d : 0d);
                                        var fallbackScore = Math.Round(Math.Clamp(calculatedRawScore, 0d, 100d), 1, MidpointRounding.AwayFromZero);
                                        var qualityScore = prop.QualityScore.HasValue
                                            ? Math.Round((double)prop.QualityScore.Value, 1, MidpointRounding.AwayFromZero)
                                            : fallbackScore;

                                        <tr
                                            data-proposal-id="@prop.Id"
                                            data-invalidated="@(prop.Invalidated ? "true" : "false")"
                                            data-price="@(prop.EstimatedValue?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty)"
                                            data-lead-time="@(prop.EstimatedLeadTimeHours?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty)"
                                            data-warranty="@(prop.WarrantyDays?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty)"
                                            data-rating="@providerRating.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-reviews="@providerReviews"
                                            data-score="@qualityScore.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                            <td class="comparison-rank text-muted fw-bold">-</td>
                                            <td>
                                                <div class="fw-semibold">@prop.ProviderName</div>
                                                <div class="small mt-1">
                                                    <span class="badge rounded-pill @trustBadgeClass">@trustStatusLabel</span>
                                                </div>
                                                <div class="small text-muted">@providerReviews avaliacao(oes)</div>
                                            </td>
                                            <td>@(prop.EstimatedValue.HasValue ? prop.EstimatedValue.Value.ToString("C") : "N/I")</td>
                                            <td>@(prop.EstimatedLeadTimeHours.HasValue ? $"{prop.EstimatedLeadTimeHours.Value}h" : "N/I")</td>
                                            <td>@(prop.WarrantyDays.HasValue ? $"{prop.WarrantyDays.Value} dias" : "N/I")</td>
                                            <td>@(providerRating > 0d ? providerRating.ToString("0.0", new System.Globalization.CultureInfo("pt-BR")) : "N/I")</td>
                                            <td>
                                                <span class="badge rounded-pill text-bg-primary">@qualityScore.ToString("0.0", new System.Globalization.CultureInfo("pt-BR"))</span>
                                            </td>
                                            <td class="text-end">
                                                <a class="btn btn-sm btn-outline-primary rounded-pill" href="#proposal-@prop.Id">Ver proposta</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
            </section>

            <section class="details-tab-pane" data-pane="proposals">
            <h4 class="fw-bold mb-4 mt-5">
                <i class="fas fa-hand-holding-usd text-success me-2"></i>
                Propostas Recebidas (<span id="proposals-count">@proposals.Count</span>)
            </h4>

            <div id="proposals-section">
                @if (!proposals.Any())
                {
                    <div class="card border-0 shadow-sm p-5 text-center bg-white rounded-4">
                        <div class="mb-3 text-muted">
                            <div class="spinner-border text-primary mb-3" role="status">
                                <span class="visually-hidden">Procurando...</span>
                            </div>
                        </div>
                        <h5>Buscando profissionais disponiveis...</h5>
                        <p class="text-muted">Seu pedido já foi divulgado. Aguarde para receber propostas de prestadores.</p>
                    </div>
                }
                else
                {
                    <div class="row g-4">
                        @foreach (var prop in proposals)
                        {
                            providerReputations.TryGetValue(prop.ProviderId, out var providerReputation);
                            var hasProviderReviews = providerReputation != null && providerReputation.TotalReviews > 0;
                            var providerAverageRatingLabel = hasProviderReviews
                                ? providerReputation!.AverageRating.ToString("0.0", new System.Globalization.CultureInfo("pt-BR"))
                                : "Novo";
                            var providerReviewCountLabel = hasProviderReviews
                                ? $"{providerReputation!.TotalReviews} avaliacoes"
                                : "sem avaliacoes";
                            var trustStatusLabel = prop.ProviderTrustStatus switch
                            {
                                ConsertaPraMim.Domain.Enums.ProviderTrustStatus.Verified => "Selo verificado",
                                ConsertaPraMim.Domain.Enums.ProviderTrustStatus.Restricted => "Conta restrita",
                                _ => "Verificacao pendente"
                            };
                            var trustBadgeClass = prop.ProviderTrustStatus switch
                            {
                                ConsertaPraMim.Domain.Enums.ProviderTrustStatus.Verified => "bg-success-subtle text-success border border-success-subtle",
                                ConsertaPraMim.Domain.Enums.ProviderTrustStatus.Restricted => "bg-danger-subtle text-danger border border-danger-subtle",
                                _ => "bg-warning-subtle text-warning border border-warning-subtle"
                            };
                            <div class="col-12">
                                <div id="proposal-@prop.Id" class="card border-0 shadow-sm @(prop.Accepted ? "border border-success bg-success-subtle" : "bg-white") rounded-4 transition-hover">
                                    <div class="card-body p-4">
                                        <div class="row align-items-center g-3">
                                            <div class="col-md-1">
                                                <img src="https://ui-avatars.com/api/?name=@prop.ProviderName&background=random" class="rounded-circle shadow-sm" width="60" alt="Provider">
                                            </div>
                                            <div class="col-md-5 ps-md-4">
                                                <h5 class="fw-bold mb-0">@prop.ProviderName</h5>
                                                <div class="text-warning small mb-1">
                                                    <i class="fas fa-star"></i> @providerAverageRatingLabel <span class="text-muted small fw-normal">(@providerReviewCountLabel)</span>
                                                </div>
