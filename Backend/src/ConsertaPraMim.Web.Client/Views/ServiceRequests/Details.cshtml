</script>
<script>
    (() => {
        const triggers = Array.from(document.querySelectorAll('.request-tab-trigger'));
        const panes = Array.from(document.querySelectorAll('.details-tab-pane'));
        if (!triggers.length || !panes.length) {
            return;
        }

        const setActivePane = (target, syncUrl = true) => {
            triggers.forEach((trigger) => {
                const isActive = trigger.getAttribute('data-target') === target;
                trigger.classList.toggle('active', isActive);
                trigger.setAttribute('aria-selected', isActive ? 'true' : 'false');
            });

            panes.forEach((pane) => {
                const isActive = pane.getAttribute('data-pane') === target;
                pane.classList.toggle('active', isActive);
            });

            if (syncUrl) {
                const url = new URL(window.location.href);
                url.searchParams.set('tab', target);
                window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
            }
        };

        triggers.forEach((trigger) => {
            trigger.addEventListener('click', () => {
                const target = trigger.getAttribute('data-target');
                if (!target) {
                    return;
                }

                setActivePane(target);
            });
        });

        const requestedTab = new URLSearchParams(window.location.search).get('tab');
        const fallbackTab = triggers.find((trigger) => trigger.classList.contains('active'))?.getAttribute('data-target') || 'appointment';
        const targetTab = triggers.some((trigger) => trigger.getAttribute('data-target') === requestedTab)
            ? requestedTab
            : fallbackTab;

        setActivePane(targetTab, false);
    })();
</script>
<script>
    (() => {
        const config = window.clientSupportHelpConfig;
        if (!config?.pollUrl || !config.pollIntervalMs || !config.snapshot) {
            return;
        }

        const normalizeSnapshot = (snapshot) => {
            if (!snapshot?.hasTicket) {
                return null;
            }

            return JSON.stringify({
                ticketId: snapshot.ticketId || null,
                status: snapshot.status || null,
                messageCount: Number(snapshot.messageCount || 0),
                lastInteractionAtUtc: snapshot.lastInteractionAtUtc || null
            });
        };

        let currentSnapshot = normalizeSnapshot(config.snapshot);
        if (!currentSnapshot) {
            return;
        }

        let pollingInFlight = false;

        const shouldPoll = () => {
            return document.querySelector('.details-tab-pane[data-pane="help"]')?.classList.contains('active') === true;
        };

        const reloadHelpTab = () => {
            const url = new URL(window.location.href);
            url.searchParams.set('tab', 'help');
            window.location.replace(`${url.pathname}${url.search}${url.hash}`);
        };

        const poll = async () => {
            if (pollingInFlight || !shouldPoll()) {
                return;
            }

            pollingInFlight = true;
            try {
                const response = await fetch(config.pollUrl, {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    credentials: 'same-origin',
                    cache: 'no-store'
                });

                if (!response.ok) {
                    return;
                }

                const nextSnapshot = normalizeSnapshot(await response.json());
                if (nextSnapshot && nextSnapshot !== currentSnapshot) {
                    reloadHelpTab();
                    return;
                }

                currentSnapshot = nextSnapshot || currentSnapshot;
            } catch {
                // polling silencioso para nao degradar a navegacao do cliente
            } finally {
                pollingInFlight = false;
            }
        };

        window.setInterval(poll, config.pollIntervalMs);
    })();
</script>
<script>
    (() => {
        const triggerSelector = '[data-support-attachment-trigger]';
        const modalElement = document.getElementById('supportAttachmentLightboxModal');
        const bodyElement = document.getElementById('supportAttachmentLightboxBody');
        const titleElement = document.getElementById('supportAttachmentLightboxTitle');
        const subtitleElement = document.getElementById('supportAttachmentLightboxSubtitle');
        const openLinkElement = document.getElementById('supportAttachmentLightboxOpenLink');

        if (!modalElement || !bodyElement || !titleElement || !subtitleElement || !openLinkElement || typeof bootstrap === 'undefined') {
            return;
        }

        const modal = bootstrap.Modal.getOrCreateInstance(modalElement);

        const renderBody = (kind, fileUrl, fileName, contentType) => {
            const normalizedKind = String(kind || '').toLowerCase();
            const safeUrl = String(fileUrl || '');
            const safeName = String(fileName || 'Anexo');
            const safeType = String(contentType || 'application/octet-stream');

            if (normalizedKind === 'image') {
                bodyElement.innerHTML = `<img src="${safeUrl}" alt="${safeName}" class="img-fluid rounded shadow" style="max-height: calc(100vh - 160px);" />`;
                return;
            }

            if (normalizedKind === 'video') {
                bodyElement.innerHTML = `
                    <video controls class="w-100 rounded shadow" style="max-height: calc(100vh - 160px);" preload="metadata">
                        <source src="${safeUrl}" type="${safeType}">
                        Seu navegador nao suporta video incorporado.
                    </video>`;
                return;
            }

            if (normalizedKind === 'audio') {
                bodyElement.innerHTML = `
                    <div class="text-center w-100">
                        <div class="display-4 mb-3"><i class="fas fa-volume-high"></i></div>
                        <audio controls class="w-100" preload="metadata">
                            <source src="${safeUrl}" type="${safeType}">
                            Seu navegador nao suporta audio incorporado.
                        </audio>
                    </div>`;
                return;
            }

            bodyElement.innerHTML = `
                <div class="text-center border border-secondary rounded-4 p-4 p-md-5 w-100" style="max-width: 720px;">
                    <div class="display-4 mb-3 text-white-50"><i class="fas fa-file-lines"></i></div>
                    <h3 class="h5 mb-2">${safeName}</h3>
                    <p class="text-white-50 mb-4">Esse tipo de arquivo nao possui preview embutido. Use o botao acima para abrir em nova guia.</p>
                    <a href="${safeUrl}" target="_blank" rel="noopener noreferrer" class="btn btn-outline-light rounded-pill px-4">
                        <i class="fas fa-up-right-from-square me-2"></i>Abrir arquivo
                    </a>
                </div>`;
        };

        document.addEventListener('click', (event) => {
            const trigger = event.target.closest(triggerSelector);
            if (!trigger) {
                return;
            }

            event.preventDefault();

            const fileUrl = trigger.getAttribute('data-file-url') || '';
            const fileName = trigger.getAttribute('data-file-name') || 'Anexo';
            const contentType = trigger.getAttribute('data-content-type') || 'application/octet-stream';
            const mediaKind = trigger.getAttribute('data-media-kind') || 'document';

            titleElement.textContent = fileName;
            subtitleElement.textContent = contentType;
            openLinkElement.href = fileUrl;
            openLinkElement.classList.toggle('d-none', !fileUrl);
            renderBody(mediaKind, fileUrl, fileName, contentType);
            modal.show();
        });

        modalElement.addEventListener('hidden.bs.modal', () => {
            bodyElement.innerHTML = '';
        });
    })();
</script>
<script>
    (() => {
        const sortSelect = document.getElementById('proposal-comparison-sort');
        const tableBody = document.getElementById('proposal-comparison-body');
        if (!sortSelect || !tableBody) {
            return;
        }

        const parseNumber = (value, fallback) => {
            const normalized = Number(value);
            return Number.isFinite(normalized) ? normalized : fallback;
        };

        const compareRows = (leftRow, rightRow, sortBy) => {
            const leftInvalidated = leftRow.dataset.invalidated === 'true' ? 1 : 0;
            const rightInvalidated = rightRow.dataset.invalidated === 'true' ? 1 : 0;
            if (leftInvalidated !== rightInvalidated) {
                return leftInvalidated - rightInvalidated;
            }

            const leftPrice = parseNumber(leftRow.dataset.price, Number.MAX_VALUE);
            const rightPrice = parseNumber(rightRow.dataset.price, Number.MAX_VALUE);
            const leftLeadTime = parseNumber(leftRow.dataset.leadTime, Number.MAX_VALUE);
            const rightLeadTime = parseNumber(rightRow.dataset.leadTime, Number.MAX_VALUE);
            const leftWarranty = parseNumber(leftRow.dataset.warranty, Number.MIN_SAFE_INTEGER);
            const rightWarranty = parseNumber(rightRow.dataset.warranty, Number.MIN_SAFE_INTEGER);
            const leftRating = parseNumber(leftRow.dataset.rating, 0);
            const rightRating = parseNumber(rightRow.dataset.rating, 0);
            const leftReviews = parseNumber(leftRow.dataset.reviews, 0);
            const rightReviews = parseNumber(rightRow.dataset.reviews, 0);
            const leftScore = parseNumber(leftRow.dataset.score, 0);
            const rightScore = parseNumber(rightRow.dataset.score, 0);

            switch (sortBy) {
                case 'lowest_price':
                    return leftPrice - rightPrice || leftLeadTime - rightLeadTime || rightRating - leftRating;
                case 'fastest_lead_time':
                    return leftLeadTime - rightLeadTime || leftPrice - rightPrice || rightRating - leftRating;
                case 'best_rating':
                    return rightRating - leftRating || rightReviews - leftReviews || leftPrice - rightPrice;
                case 'highest_warranty':
                    return rightWarranty - leftWarranty || rightRating - leftRating || leftPrice - rightPrice;
                default:
                    return rightScore - leftScore || leftPrice - rightPrice || leftLeadTime - rightLeadTime;
            }
        };

        const applySort = () => {
            const rows = Array.from(tableBody.querySelectorAll('tr[data-proposal-id]'));
            rows.sort((leftRow, rightRow) => compareRows(leftRow, rightRow, sortSelect.value));
            rows.forEach((row, index) => {
                const rankCell = row.querySelector('.comparison-rank');
                if (rankCell) {
                    rankCell.textContent = String(index + 1);
                }

                tableBody.appendChild(row);
            });
        };

        sortSelect.addEventListener('change', applySort);
        applySort();
    })();
</script>
