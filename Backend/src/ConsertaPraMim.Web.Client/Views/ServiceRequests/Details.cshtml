                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                        <span class="badge rounded-pill @SupportTicketStatusBadgeClass(supportHelpTicket.Status)">@SupportTicketStatusLabel(supportHelpTicket.Status)</span>
                        <span class="badge rounded-pill bg-light text-dark border border-light-subtle">#@supportHelpTicket.Id.ToString("N")[..8]</span>
                        <span class="badge rounded-pill bg-light text-dark border border-light-subtle">@supportHelpMessages.Count mensagem(ns)</span>
                        @if (!string.IsNullOrWhiteSpace(supportHelpTicket.AssignedAdminName))
                        {
                            <span class="badge rounded-pill bg-light text-dark border border-light-subtle">Responsavel: @supportHelpTicket.AssignedAdminName</span>
                        }
