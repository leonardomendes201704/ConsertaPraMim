                    <div class="support-help-timeline mb-3">
                        @foreach (var supportMessage in supportHelpMessages)
                        {
                            var roleCss = string.Equals(supportMessage.AuthorRole, "Admin", StringComparison.OrdinalIgnoreCase)
                                ? "admin"
                                : "client";

                            <div class="support-help-message @roleCss">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                    <div class="d-flex flex-wrap align-items-center gap-2">
                                        <span class="badge rounded-pill @SupportAuthorBadgeClass(supportMessage.AuthorRole)">@supportMessage.AuthorRole</span>
                                        <span class="fw-semibold">@supportMessage.AuthorName</span>
                                    </div>
                                    <span class="text-muted small">@supportMessage.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                                </div>
                                <div class="support-help-message-text">@supportMessage.MessageText</div>

                                @if (supportMessage.Attachments.Any())
                                {
                                    <div class="support-help-attachments">
                                        @foreach (var attachment in supportMessage.Attachments)
                                        {
                                            var normalizedMediaKind = (attachment.MediaKind ?? string.Empty).ToLowerInvariant();
                                            var canPreviewInLightbox = normalizedMediaKind is "image" or "video" or "audio" or "document";
                                            <button type="button"
                                                    class="support-help-attachment-btn"
                                                    title="@attachment.FileName"
                                                    data-support-attachment-trigger
                                                    data-file-url="@attachment.FileUrl"
                                                    data-file-name="@attachment.FileName"
                                                    data-content-type="@attachment.ContentType"
                                                    data-media-kind="@attachment.MediaKind"
                                                    @(canPreviewInLightbox ? null : "disabled")>
                                                <i class="@SupportAttachmentIconClass(attachment.MediaKind)"></i>
                                                <span class="support-help-attachment-text">
                                                    <span class="support-help-attachment-name">@attachment.FileName</span>
                                                    <span class="support-help-attachment-meta">@FormatAttachmentSize(attachment.SizeBytes) &bull; @SupportAttachmentActionLabel(attachment.MediaKind)</span>
                                                </span>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                <div class="border-top pt-3">
                    @if (supportHelpTicket != null && string.Equals(supportHelpTicket.Status, "Closed", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="alert alert-secondary border-0 mb-0">
                            Este atendimento foi encerrado pelo time admin. Se precisar de continuidade, aguarde reabertura pelo suporte.
                        </div>
                    }
                    else
                    {
                        <form asp-action="AddSupportHelpMessage" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="requestId" value="@Model.Id" />
                            <div class="mb-3">
                                <label class="form-label fw-semibold" for="supportHelpMessage">Mensagem</label>
                                <textarea id="supportHelpMessage"
                                          name="message"
                                          class="form-control"
                                          rows="4"
                                          maxlength="3000"
                                          placeholder="Descreva sua duvida, problema ou o que precisa do time admin."></textarea>
                                <div class="form-text">Voce pode enviar somente anexos, se preferir.</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold" for="supportHelpAttachments">Anexos</label>
                                <input id="supportHelpAttachments"
                                       name="attachments"
                                       type="file"
                                       class="form-control"
                                       multiple
                                       accept=".jpg,.jpeg,.png,.webp,.gif,.mp4,.webm,.mov,.avi,.mp3,.wav,.ogg,.m4a,.aac,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.zip" />
                                <div class="form-text">Permitido: fotos, documentos, videos e audio (ate 25MB por arquivo).</div>
                            </div>
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <span class="small text-muted">Historico vinculado a este pedido.</span>
                                <button type="submit" class="btn btn-primary rounded-pill px-4">
                                    <i class="fas fa-paper-plane me-2"></i>@(supportHelpTicket == null ? "Iniciar atendimento" : "Enviar mensagem")
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>
            </section>
        </div>
    </div>
</div>

