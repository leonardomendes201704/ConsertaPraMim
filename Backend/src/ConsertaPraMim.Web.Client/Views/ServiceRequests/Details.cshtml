                    {
                        <div class="small text-muted mb-2">Voce ja avaliou este atendimento.</div>
                        <div class="text-warning mb-2">
                            @for (var i = 1; i <= 5; i++)
                            {
                                <i class="fas fa-star @(i <= Model.Rating.Value ? string.Empty : "text-secondary opacity-25")"></i>
                            }
                        </div>
