	        pollUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("SupportHelpSnapshot", "ServiceRequests", new { id = Model.Id }) ?? string.Empty)),
        pollIntervalMs: 10000,
        snapshot: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            supportHelpTicket == null
                ? null
                : new
                {
                    hasTicket = true,
