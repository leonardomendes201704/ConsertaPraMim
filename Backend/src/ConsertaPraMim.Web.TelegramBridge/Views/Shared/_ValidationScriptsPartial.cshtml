@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    var webRoot = Env.WebRootPath ?? string.Empty;
    var jqueryValidatePath = System.IO.Path.Combine(
        webRoot,
        "lib",
        "jquery-validation",
        "dist",
        "jquery.validate.min.js");
    var jqueryValidateUnobtrusivePath = System.IO.Path.Combine(
        webRoot,
        "lib",
        "jquery-validation-unobtrusive",
        "dist",
        "jquery.validate.unobtrusive.min.js");
}

@if (System.IO.File.Exists(jqueryValidatePath))
{
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
}

@if (System.IO.File.Exists(jqueryValidateUnobtrusivePath))
{
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}
