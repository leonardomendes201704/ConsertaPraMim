@{
    ViewData["Title"] = "Telegram Bridge";
}

<div class="wa-shell">
    <aside class="wa-sidebar">
        <div class="wa-sidebar-header">
            <h1>Telegram Bridge</h1>
            <div class="wa-sidebar-actions">
                <span class="wa-status-chip" id="connectionBadge">Conectando...</span>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="wa-logout-button">Sair</button>
                </form>
            </div>
        </div>

        <div id="conversationList" class="wa-conversation-list" aria-live="polite"></div>
    </aside>

    <section class="wa-main">
        <header class="wa-main-header" id="activeConversationHeader">
            <div class="wa-main-title" id="activeConversationTitle">Selecione uma conversa</div>
            <div class="wa-main-subtitle" id="activeConversationSubtitle">Aguardando selecao de chat</div>
        </header>

        <main id="messagesContainer" class="wa-messages">
            <div class="wa-empty-state">
                <h2>Conversa em tempo real</h2>
                <p>
                    Seu atendimento e vinculado automaticamente ao login.
                    Envie mensagens e anexos que a conversa permanece sincronizada em tempo real.
                </p>
            </div>
        </main>

        <div id="pendingAttachments" class="wa-pending-attachments"></div>

        <form id="sendMessageForm" class="wa-composer" enctype="multipart/form-data" autocomplete="off">
            <label class="wa-attach-button" for="attachmentInput" title="Adicionar anexos">
                <span>+</span>
            </label>
            <input id="attachmentInput" name="files" type="file" multiple />

            <textarea
                id="messageInput"
                name="text"
                rows="1"
                placeholder="Digite uma mensagem"
                maxlength="4000"></textarea>

            <button id="sendMessageButton" type="submit">Enviar</button>
        </form>
    </section>
</div>

@section Scripts
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/chat.js" asp-append-version="true"></script>
}
