FROM node:22-alpine AS build
WORKDIR /app

COPY ["conserta-pra-mim-admin app/package.json", "conserta-pra-mim-admin app/package-lock.json", "./"]
RUN npm ci

COPY ["conserta-pra-mim-admin app/", "./"]

ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build

FROM nginx:1.27-alpine AS final
WORKDIR /usr/share/nginx/html

COPY Backend/docker/vps/nginx.mobile.webview.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist ./

EXPOSE 8080
